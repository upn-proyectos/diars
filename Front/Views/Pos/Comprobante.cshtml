@model Minimarket.Negocio.DTOs.VentaDto
@{
    ViewData["Title"] = $"Comprobante {Model.NumeroBoleta}";
    var cfg = ViewBag.Configuracion as Minimarket.Negocio.DTOs.ConfiguracionTiendaDto ?? new Minimarket.Negocio.DTOs.ConfiguracionTiendaDto();
}

<style>
    @@media print {
        body > aside, body > div > header, body > div > footer, .no-print {
            display: none !important;
        }
        body, main {
            background: #ffffff !important;
            padding: 0 !important;
        }
        .comprobante-card {
            box-shadow: none !important;
            border: 1px solid #cbd5e1 !important;
            max-width: 100% !important;
        }
    }
</style>

<div class="max-w-2xl mx-auto space-y-5">
    <!-- Botones de Acción (No se imprimen) -->
    <div class="no-print flex flex-wrap items-center justify-between gap-3">
        <a asp-controller="Pos" asp-action="Index" class="btn-brand-secondary">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
            <span>Volver al Punto de Venta</span>
        </a>

        <button type="button" onclick="window.print()" class="btn-brand-primary">
            <i data-lucide="printer" class="w-4 h-4"></i>
            <span>Imprimir Comprobante</span>
        </button>
    </div>

    <!-- Boleta de Venta -->
    <div class="card-chininin p-8 comprobante-card">
        <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 pb-6 border-b border-slate-200">
            <div>
                <div class="flex items-center gap-2.5">
                    <div class="w-10 h-10 rounded-xl bg-brand-600 text-white grid place-items-center font-bold">
                        CH
                    </div>
                    <div>
                        <h1 class="text-lg font-bold text-slate-900">@cfg.NombreComercio</h1>
                        <p class="text-xs text-slate-500">RUC: <span class="font-mono font-semibold">@cfg.Ruc</span></p>
                    </div>
                </div>
                <p class="text-xs text-slate-500 mt-2">@cfg.Direccion</p>
            </div>

            <div class="border-2 border-brand-600 rounded-xl px-5 py-3 text-center bg-brand-50/40">
                <div class="text-[11px] font-bold uppercase tracking-wider text-brand-800">Boleta de Venta Interna</div>
                <div class="text-lg font-mono font-bold text-brand-700 mt-0.5">@Model.NumeroBoleta</div>
            </div>
        </div>

        <!-- Datos del Cliente y Operación -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 py-5 border-b border-slate-100 text-xs">
            <div class="space-y-1.5">
                <div><span class="text-slate-400 font-medium">Cliente:</span> <strong class="text-slate-800">@Model.ClienteNombre</strong></div>
                <div><span class="text-slate-400 font-medium">@Model.ClienteTipoDoc:</span> <span class="font-mono font-semibold text-slate-700">@Model.ClienteDocumento</span></div>
                @if (!string.IsNullOrWhiteSpace(Model.ClienteDireccion) && Model.ClienteDireccion != "-")
                {
                    <div><span class="text-slate-400 font-medium">Dirección:</span> <span class="text-slate-700">@Model.ClienteDireccion</span></div>
                }
            </div>
            <div class="space-y-1.5 sm:text-right">
                <div><span class="text-slate-400 font-medium">Fecha de Emisión:</span> <strong class="text-slate-800">@Model.Fecha.ToString("dd/MM/yyyy HH:mm:ss")</strong></div>
                <div><span class="text-slate-400 font-medium">Atendido por:</span> <span class="text-slate-700">@Model.CajeroNombre</span></div>
                <div>
                    <span class="text-slate-400 font-medium">Medio de Pago (Strategy):</span>
                    <span class="badge-chininin bg-brand-50 text-brand-700 ml-1">@Model.MetodoPago</span>
                </div>
            </div>
        </div>

        <!-- Tabla de Productos Vendidos -->
        <div class="py-4">
            <table class="table-chininin">
                <thead>
                    <tr>
                        <th>Descripción del Producto</th>
                        <th class="text-center">Cant.</th>
                        <th class="text-right">P. Unit.</th>
                        <th class="text-right">Importe</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Detalles)
                    {
                        <tr>
                            <td class="font-medium text-slate-900">@item.NombreProducto</td>
                            <td class="text-center font-mono text-xs">@item.Cantidad.ToString("0.###")</td>
                            <td class="text-right text-slate-600">S/ @item.PrecioUnitario.ToString("0.00")</td>
                            <td class="text-right font-semibold text-slate-900">S/ @item.Subtotal.ToString("0.00")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Totales -->
        <div class="pt-4 border-t border-slate-200 flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4">
            <div class="text-[11px] text-slate-400 max-w-xs">
                Comprobante interno generado mediante el <strong>Patrón Singleton</strong> y procesado con el <strong>Patrón Strategy</strong>. Los precios incluyen IGV.
            </div>

            <div class="w-full sm:w-64 space-y-1.5 text-sm">
                <div class="flex justify-between text-slate-600">
                    <span>Op. Gravada (Subtotal)</span>
                    <span>S/ @Model.Subtotal.ToString("0.00")</span>
                </div>
                <div class="flex justify-between text-slate-600">
                    <span>IGV (@((cfg.TasaIgv * 100).ToString("0"))%)</span>
                    <span>S/ @Model.Igv.ToString("0.00")</span>
                </div>
                <div class="flex justify-between items-center pt-2 border-t border-slate-200 font-bold text-base text-slate-900">
                    <span>Importe Total</span>
                    <span class="text-xl text-brand-700">S/ @Model.Total.ToString("0.00")</span>
                </div>
            </div>
        </div>
    </div>
</div>
