@model List<Minimarket.Negocio.DTOs.CategoriaItemDto>
@{
    ViewData["Title"] = "Categorías de Productos";
    var toastExito = TempData["ToastExito"] as string;
    var toastError = TempData["ToastError"] as string;

    // Paleta de colores idéntica a Categorias.tsx
    string[] colores = new[]
    {
        "bg-amber-100 text-amber-800",
        "bg-sky-100 text-sky-700",
        "bg-indigo-100 text-indigo-700",
        "bg-pink-100 text-pink-700",
        "bg-emerald-100 text-emerald-700",
        "bg-violet-100 text-violet-700",
        "bg-orange-100 text-orange-700",
        "bg-blue-100 text-blue-700"
    };
}

<div class="space-y-6">
    <!-- Notificaciones Toast -->
    @if (!string.IsNullOrWhiteSpace(toastExito))
    {
        <div id="toastCatExito" class="flex items-center justify-between gap-3 px-4 py-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm shadow-sm">
            <div class="flex items-center gap-2.5">
                <i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-600 shrink-0"></i>
                <span class="font-medium">@toastExito</span>
            </div>
            <button type="button" onclick="document.getElementById('toastCatExito')?.remove()" class="text-emerald-600 hover:text-emerald-800 p-1">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(toastError))
    {
        <div id="toastCatError" class="flex items-center justify-between gap-3 px-4 py-3 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm shadow-sm">
            <div class="flex items-center gap-2.5">
                <i data-lucide="alert-circle" class="w-5 h-5 text-red-600 shrink-0"></i>
                <span class="font-medium">@toastError</span>
            </div>
            <button type="button" onclick="document.getElementById('toastCatError')?.remove()" class="text-red-600 hover:text-red-800 p-1">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>
    }

    <!-- Encabezado (Igual a Categorias.tsx) -->
    <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Categorías</h1>
            <p class="text-slate-500 text-sm mt-1">Organiza tus productos por categoría (@Model.Count registradas)</p>
        </div>
        <div class="flex items-center gap-2">
            <a asp-controller="Productos" asp-action="Index" class="btn-brand-secondary">
                <i data-lucide="package" class="w-4 h-4"></i>
                <span>Ver Productos</span>
            </a>
            <button type="button" onclick="abrirModalNuevaCategoria()" class="btn-brand-primary">
                <i data-lucide="plus" class="w-4 h-4"></i>
                <span>Nueva categoría</span>
            </button>
        </div>
    </div>

    <!-- Grid de Tarjetas de Categorías (Idéntico a Categorias.tsx) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        @for (int i = 0; i < Model.Count; i++)
        {
            var cat = Model[i];
            var badgeColor = colores[i % colores.Length];
            var porcentajeBarra = Math.Min((cat.TotalProductos / 15.0) * 100.0, 100.0);

            <div class="card-chininin p-5 hover:shadow-md transition-shadow flex flex-col justify-between">
                <div>
                    <div class="flex items-start justify-between gap-2">
                        <div class="badge-chininin text-sm !px-3 !py-1.5 @badgeColor">
                            <i data-lucide="tag" class="w-3.5 h-3.5"></i>
                            <span>@cat.Nombre</span>
                        </div>
                        <div class="flex gap-1">
                            <button type="button"
                                    title="Editar categoría"
                                    onclick="abrirModalEditarCategoria(@cat.Id, '@Html.Raw(cat.Nombre.Replace("'", "\\'"))', '@Html.Raw((cat.Descripcion ?? "").Replace("'", "\\'"))')"
                                    class="btn-brand-ghost p-1.5">
                                <i data-lucide="pencil" class="w-4 h-4"></i>
                            </button>
                            <button type="button"
                                    title="Eliminar categoría"
                                    onclick="abrirModalEliminarCategoria(@cat.Id, '@Html.Raw(cat.Nombre.Replace("'", "\\'"))', @cat.TotalProductos)"
                                    class="btn-brand-ghost p-1.5 text-red-500 hover:bg-red-50 hover:text-red-600">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(cat.Descripcion))
                    {
                        <p class="text-xs text-slate-400 mt-2 line-clamp-1">@cat.Descripcion</p>
                    }
                </div>

                <div>
                    <div class="mt-4 text-4xl font-bold text-slate-900">@cat.TotalProductos</div>
                    <div class="text-sm text-slate-500 mt-0.5">
                        producto@(cat.TotalProductos != 1 ? "s" : "") asignado@(cat.TotalProductos != 1 ? "s" : "")
                    </div>
                    <div class="mt-3 h-1.5 bg-slate-100 rounded-full overflow-hidden">
                        <div class="h-full rounded-full bg-brand-500 transition-all" style="width: @(porcentajeBarra.ToString("0", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                    </div>
                </div>
            </div>
        }

        <!-- Tarjeta Punteada "+ Nueva categoría" (Igual a Categorias.tsx) -->
        <button type="button" onclick="abrirModalNuevaCategoria()"
                class="card-chininin p-5 border-2 border-dashed border-slate-200 hover:border-brand-400 hover:bg-brand-50/30 transition-all flex flex-col items-center justify-center gap-2 text-slate-400 hover:text-brand-600 min-h-[160px] cursor-pointer">
            <i data-lucide="plus" class="w-7 h-7"></i>
            <span class="text-sm font-medium">Nueva categoría</span>
        </button>
    </div>
</div>

<!-- =======================================================================
     MODAL CREAR / EDITAR CATEGORÍA
     ======================================================================= -->
<div id="modalCategoria" class="fixed inset-0 bg-black/40 backdrop-blur-sm z-50 hidden place-items-center p-4">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-sm overflow-hidden">
        <div class="flex items-center justify-between p-5 border-b border-slate-100">
            <h2 id="modalCategoriaTitulo" class="font-bold text-slate-900 text-lg">Nueva categoría</h2>
            <button type="button" onclick="cerrarModalCategoria()" class="btn-brand-ghost p-1.5">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>

        <form asp-controller="Categorias" asp-action="Guardar" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" id="catId" name="Id" value="" />

            <div class="p-5 space-y-4">
                <p class="text-xs text-slate-400"><span class="text-red-500">*</span> Campos obligatorios</p>

                <div>
                    <label for="catNombre" class="block text-sm font-medium text-slate-700 mb-1">
                        Nombre de la categoría <span class="text-red-500">*</span>
                    </label>
                    <input id="catNombre" name="Nombre" type="text" required minlength="3"
                           oninput="actualizarPreviewCategoria()"
                           placeholder="Ej: Bebidas, Abarrotes, Snacks..."
                           class="input-chininin" />
                </div>

                <div>
                    <label for="catDescripcion" class="block text-sm font-medium text-slate-700 mb-1">
                        Descripción breve (Opcional)
                    </label>
                    <input id="catDescripcion" name="Descripcion" type="text"
                           placeholder="Ej: Galletas, chocolates y piqueos"
                           class="input-chininin" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1.5">Vista previa de etiqueta</label>
                    <span class="badge-chininin bg-brand-50 text-brand-700 border border-brand-200 text-sm !px-3 !py-1.5">
                        <i data-lucide="tag" class="w-3.5 h-3.5"></i>
                        <span id="previewCatNombre">Categoría</span>
                    </span>
                </div>
            </div>

            <div class="flex gap-3 p-5 border-t border-slate-100 bg-slate-50/50">
                <button type="button" onclick="cerrarModalCategoria()" class="btn-brand-secondary flex-1">
                    Cancelar
                </button>
                <button type="submit" id="btnGuardarCategoria" class="btn-brand-primary flex-1">
                    Crear
                </button>
            </div>
        </form>
    </div>
</div>

<!-- =======================================================================
     MODAL CONFIRMAR ELIMINACIÓN DE CATEGORÍA
     ======================================================================= -->
<div id="modalEliminarCategoria" class="fixed inset-0 bg-black/40 backdrop-blur-sm z-50 hidden place-items-center p-4">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-sm p-6 text-center">
        <div class="w-12 h-12 rounded-full bg-red-50 grid place-items-center mx-auto mb-4">
            <i data-lucide="trash-2" class="w-6 h-6 text-red-500"></i>
        </div>
        <h3 class="font-bold text-slate-900 text-lg">¿Eliminar categoría?</h3>
        <p id="txtEliminarCategoriaDetalle" class="text-slate-500 text-sm mt-1 mb-5">
            Se eliminará la categoría seleccionada.
        </p>

        <form asp-controller="Categorias" asp-action="Eliminar" method="post" class="flex gap-3">
            @Html.AntiForgeryToken()
            <input type="hidden" id="eliminarCatId" name="id" value="" />
            <button type="button" onclick="cerrarModalEliminarCategoria()" class="btn-brand-secondary flex-1">
                Cancelar
            </button>
            <button type="submit" class="btn-brand-primary !bg-red-600 hover:!bg-red-700 flex-1">
                Eliminar
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function abrirModalNuevaCategoria() {
            document.getElementById('modalCategoriaTitulo').textContent = 'Nueva categoría';
            document.getElementById('btnGuardarCategoria').textContent = 'Crear';
            document.getElementById('catId').value = '';
            document.getElementById('catNombre').value = '';
            document.getElementById('catDescripcion').value = '';
            document.getElementById('previewCatNombre').textContent = 'Categoría';

            const modal = document.getElementById('modalCategoria');
            modal.classList.remove('hidden');
            modal.classList.add('grid');
            document.getElementById('catNombre').focus();
        }

        function abrirModalEditarCategoria(id, nombre, descripcion) {
            document.getElementById('modalCategoriaTitulo').textContent = 'Editar categoría';
            document.getElementById('btnGuardarCategoria').textContent = 'Guardar';
            document.getElementById('catId').value = id;
            document.getElementById('catNombre').value = nombre;
            document.getElementById('catDescripcion').value = descripcion || '';
            document.getElementById('previewCatNombre').textContent = nombre || 'Categoría';

            const modal = document.getElementById('modalCategoria');
            modal.classList.remove('hidden');
            modal.classList.add('grid');
            document.getElementById('catNombre').focus();
        }

        function cerrarModalCategoria() {
            const modal = document.getElementById('modalCategoria');
            modal.classList.add('hidden');
            modal.classList.remove('grid');
        }

        function actualizarPreviewCategoria() {
            const val = document.getElementById('catNombre').value.trim();
            document.getElementById('previewCatNombre').textContent = val || 'Categoría';
        }

        function abrirModalEliminarCategoria(id, nombre, totalProductos) {
            document.getElementById('eliminarCatId').value = id;
            const txt = document.getElementById('txtEliminarCategoriaDetalle');
            if (totalProductos > 0) {
                txt.innerHTML = `La categoría <strong>${nombre}</strong> tiene <strong>${totalProductos} producto(s)</strong> asignados. Primero debes reasignar o retirar esos productos.`;
            } else {
                txt.innerHTML = `Se eliminará la categoría <strong>${nombre}</strong> del catálogo.`;
            }

            const modal = document.getElementById('modalEliminarCategoria');
            modal.classList.remove('hidden');
            modal.classList.add('grid');
        }

        function cerrarModalEliminarCategoria() {
            const modal = document.getElementById('modalEliminarCategoria');
            modal.classList.add('hidden');
            modal.classList.remove('grid');
        }

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                cerrarModalCategoria();
                cerrarModalEliminarCategoria();
            }
        });
    </script>
}
