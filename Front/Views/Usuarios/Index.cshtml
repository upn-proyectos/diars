@model Minimarket.Front.Models.UsuariosViewModel
@{
    ViewData["Title"] = "Usuarios y Roles";
    var toastExito = TempData["ToastExito"] as string;
    var toastError = TempData["ToastError"] as string;
    var activos = Model.Usuarios.Count(u => u.Activo);
}

<div class="space-y-6">
    <!-- Notificaciones Toast -->
    @if (!string.IsNullOrWhiteSpace(toastExito))
    {
        <div id="toastUsrExito" class="flex items-center justify-between gap-3 px-4 py-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm shadow-sm">
            <div class="flex items-center gap-2.5">
                <i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-600 shrink-0"></i>
                <span class="font-medium">@toastExito</span>
            </div>
            <button type="button" onclick="document.getElementById('toastUsrExito')?.remove()" class="text-emerald-600 hover:text-emerald-800 p-1">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(toastError))
    {
        <div id="toastUsrError" class="flex items-center justify-between gap-3 px-4 py-3 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm shadow-sm">
            <div class="flex items-center gap-2.5">
                <i data-lucide="alert-circle" class="w-5 h-5 text-red-600 shrink-0"></i>
                <span class="font-medium">@toastError</span>
            </div>
            <button type="button" onclick="document.getElementById('toastUsrError')?.remove()" class="text-red-600 hover:text-red-800 p-1">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>
    }

    <!-- Encabezado (Idéntico a Usuarios.tsx) -->
    <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
            <div class="flex items-center gap-2">
                <h1 class="text-2xl font-bold text-slate-900">Usuarios y roles</h1>
                <span class="badge-chininin bg-purple-50 text-purple-700 border border-purple-200 text-[11px]">
                    <i data-lucide="lock" class="w-3 h-3"></i> RNF-05 · Hash PBKDF2-SHA256
                </span>
            </div>
            <p class="text-slate-500 text-sm mt-1">
                @activos usuarios activos · @Model.Usuarios.Count en total
            </p>
        </div>

        <button type="button" onclick="abrirModalNuevoUsuario()" class="btn-brand-primary">
            <i data-lucide="plus" class="w-4 h-4"></i>
            <span>Nuevo usuario</span>
        </button>
    </div>

    <!-- Tarjetas de los 3 Roles Oficiales (RF-05 / CU-02) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        @foreach (var rol in Model.Roles)
        {
            var cantidadActivos = Model.Usuarios.Count(u => u.RolNombre == rol.Nombre && u.Activo);
            var badgeClass = rol.Nombre == "Administrador"
                ? "badge-admin"
                : rol.Nombre == "Almacenero"
                    ? "badge-almacen"
                    : "badge-cajero";
            var permisos = rol.Nombre == "Administrador"
                ? "Acceso total: Configuración, Usuarios, Inventario, Compras, POS, Kardex y Reportes"
                : rol.Nombre == "Almacenero"
                    ? "Gestión de Inventario: Catálogo de Productos, Categorías, Proveedores, Compras y Kardex"
                    : "Operación en Caja: Punto de Venta (POS), Emisión de Boletas y Directorio de Clientes";

            <div class="card-chininin p-5">
                <div class="flex items-center justify-between">
                    <span class="badge-chininin @badgeClass">
                        <i data-lucide="shield-check" class="w-3.5 h-3.5"></i> @rol.Nombre
                    </span>
                    <span class="text-2xl font-bold text-slate-900">@cantidadActivos</span>
                </div>
                <p class="text-xs text-slate-500 mt-3 leading-relaxed">@permisos</p>
            </div>
        }
    </div>

    <!-- Buscador -->
    <div class="card-chininin p-4">
        <div class="relative">
            <i data-lucide="search" class="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none"></i>
            <input id="inputBuscarUsuario" type="text" oninput="filtrarUsuarios()"
                   placeholder="Buscar por nombre del trabajador, usuario o rol..."
                   class="input-chininin pl-10" />
        </div>
    </div>

    <!-- Tabla de Usuarios -->
    <div class="card-chininin overflow-hidden">
        <div class="overflow-x-auto">
            <table class="table-chininin">
                <thead>
                    <tr>
                        <th>Usuario</th>
                        <th>Nombre completo</th>
                        <th>Rol asignado</th>
                        <th>Seguridad</th>
                        <th class="text-center">Estado</th>
                        <th class="text-right">Acciones</th>
                    </tr>
                </thead>
                <tbody id="tbodyUsuarios">
                    @foreach (var u in Model.Usuarios)
                    {
                        var textoBusqueda = $"{u.Nombre} {u.UsuarioLogin} {u.RolNombre}".ToLower();
                        var badgeClass = u.RolNombre == "Administrador"
                            ? "badge-admin"
                            : u.RolNombre == "Almacenero"
                                ? "badge-almacen"
                                : "badge-cajero";

                        <tr class="fila-usuario" data-busqueda="@textoBusqueda">
                            <td>
                                <div class="flex items-center gap-2.5">
                                    <div class="w-8 h-8 rounded-full bg-slate-100 grid place-items-center text-slate-500">
                                        <i data-lucide="user-circle-2" class="w-4 h-4"></i>
                                    </div>
                                    <span class="font-mono text-sm font-semibold text-slate-800">@u.UsuarioLogin</span>
                                </div>
                            </td>
                            <td class="font-semibold text-slate-900">@u.Nombre</td>
                            <td>
                                <span class="badge-chininin @badgeClass">
                                    <i data-lucide="shield-check" class="w-3 h-3"></i> @u.RolNombre
                                </span>
                            </td>
                            <td>
                                @if (u.UsaHashSeguro)
                                {
                                    <span class="badge-chininin bg-emerald-50 text-emerald-700 text-[11px]">
                                        <i data-lucide="key-round" class="w-3 h-3"></i> PBKDF2 + Sal
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-chininin bg-amber-50 text-amber-700 text-[11px]">
                                        <i data-lucide="key" class="w-3 h-3"></i> Semilla Demo
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                @if (u.Activo)
                                {
                                    <span class="badge-chininin bg-brand-50 text-brand-700">Activo</span>
                                }
                                else
                                {
                                    <span class="badge-chininin bg-slate-100 text-slate-500">Inactivo</span>
                                }
                            </td>
                            <td class="text-right">
                                <button type="button"
                                        title="Editar cuenta"
                                        onclick="abrirModalEditarUsuario(@u.Id, '@Html.Raw(u.Nombre.Replace("'", "\\'"))', '@Html.Raw(u.UsuarioLogin.Replace("'", "\\'"))', @u.RolId, @(u.Activo ? "true" : "false"))"
                                        class="btn-brand-ghost p-1.5">
                                    <i data-lucide="pencil" class="w-4 h-4"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Crear / Editar Usuario -->
<div id="modalUsuario" class="fixed inset-0 bg-black/40 backdrop-blur-sm z-50 hidden items-center justify-center p-4" style="margin-top:0 !important;">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-md overflow-hidden">
        <div class="flex items-center justify-between p-5 border-b border-slate-100">
            <div>
                <h2 id="tituloModalUsuario" class="font-bold text-slate-900 text-lg">Nuevo usuario</h2>
                <p class="text-xs text-slate-400 mt-0.5">La contraseña se almacena encriptada con PBKDF2-SHA256 (RNF-05)</p>
            </div>
            <button type="button" onclick="cerrarModalUsuario()" class="btn-brand-ghost p-1.5">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>

        <form asp-controller="Usuarios" asp-action="Guardar" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" id="usrId" name="Id" value="" />

            <div class="p-5 space-y-4">
                <div>
                    <label for="usrNombre" class="block text-xs font-semibold text-slate-700 mb-1">
                        Nombre completo del trabajador <span class="text-red-500">*</span>
                    </label>
                    <input id="usrNombre" name="Nombre" type="text" required minlength="3" maxlength="150"
                           placeholder="Ej: Juan Carlos Pérez" class="input-chininin" />
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label for="usrLogin" class="block text-xs font-semibold text-slate-700 mb-1">
                            Usuario (login) <span class="text-red-500">*</span>
                        </label>
                        <input id="usrLogin" name="UsuarioLogin" type="text" required minlength="3" maxlength="50"
                               oninput="this.value = this.value.toLowerCase().replace(/\s+/g, '')"
                               placeholder="Ej: jperez" class="input-chininin font-mono" />
                    </div>
                    <div>
                        <label for="usrRolId" class="block text-xs font-semibold text-slate-700 mb-1">
                            Rol del sistema <span class="text-red-500">*</span>
                        </label>
                        <select id="usrRolId" name="RolId" class="input-chininin" required>
                            @foreach (var r in Model.Roles)
                            {
                                <option value="@r.Id">@r.Nombre</option>
                            }
                        </select>
                    </div>
                </div>

                <div>
                    <label id="lblUsrPassword" for="usrPassword" class="block text-xs font-semibold text-slate-700 mb-1">
                        Contraseña <span class="text-red-500">*</span>
                    </label>
                    <input id="usrPassword" name="Password" type="password" minlength="6" maxlength="128"
                           placeholder="Mínimo 6 caracteres" class="input-chininin" />
                </div>

                <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-200/80">
                    <div>
                        <div class="text-xs font-semibold text-slate-800">Estado de la cuenta</div>
                        <div class="text-[11px] text-slate-500">Permite o bloquea el inicio de sesión</div>
                    </div>
                    <select id="usrActivo" name="Activo" class="input-chininin !w-32">
                        <option value="true">Activo</option>
                        <option value="false">Inactivo</option>
                    </select>
                </div>
            </div>

            <div class="flex gap-3 p-5 border-t border-slate-100 bg-slate-50/50">
                <button type="button" onclick="cerrarModalUsuario()" class="btn-brand-secondary flex-1 justify-center">Cancelar</button>
                <button type="submit" class="btn-brand-primary flex-1 justify-center">
                    <i data-lucide="check" class="w-4 h-4"></i>
                    <span id="txtBtnGuardarUsuario">Crear usuario</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function filtrarUsuarios() {
        const q = (document.getElementById('inputBuscarUsuario').value || '').toLowerCase().trim();
        document.querySelectorAll('.fila-usuario').forEach(tr => {
            const texto = tr.getAttribute('data-busqueda') || '';
            tr.classList.toggle('hidden', q !== '' && !texto.includes(q));
        });
    }

    function abrirModalNuevoUsuario() {
        document.getElementById('usrId').value = '';
        document.getElementById('usrNombre').value = '';
        document.getElementById('usrLogin').value = '';
        document.getElementById('usrRolId').value = '3';
        document.getElementById('usrActivo').value = 'true';
        const pass = document.getElementById('usrPassword');
        pass.value = '';
        pass.required = true;
        pass.placeholder = 'Mínimo 6 caracteres';
        document.getElementById('lblUsrPassword').innerHTML = 'Contraseña <span class="text-red-500">*</span>';
        document.getElementById('tituloModalUsuario').textContent = 'Nuevo usuario';
        document.getElementById('txtBtnGuardarUsuario').textContent = 'Crear usuario';

        const modal = document.getElementById('modalUsuario');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    }

    function abrirModalEditarUsuario(id, nombre, login, rolId, activo) {
        document.getElementById('usrId').value = id;
        document.getElementById('usrNombre').value = nombre;
        document.getElementById('usrLogin').value = login;
        document.getElementById('usrRolId').value = rolId;
        document.getElementById('usrActivo').value = activo ? 'true' : 'false';
        const pass = document.getElementById('usrPassword');
        pass.value = '';
        pass.required = false;
        pass.placeholder = 'Dejar vacío para conservar la contraseña actual';
        document.getElementById('lblUsrPassword').textContent = 'Nueva contraseña (opcional)';
        document.getElementById('tituloModalUsuario').textContent = 'Editar usuario';
        document.getElementById('txtBtnGuardarUsuario').textContent = 'Guardar cambios';

        const modal = document.getElementById('modalUsuario');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    }

    function cerrarModalUsuario() {
        const modal = document.getElementById('modalUsuario');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
    }
</script>
}
