@model Minimarket.Front.Models.DashboardViewModel
@using System.Security.Claims
@{
    ViewData["Title"] = "Panel de Control Principal";
    var userRole = User.FindFirstValue(ClaimTypes.Role) ?? "Cajero";
    var userName = User.Identity?.Name ?? "Usuario";
}

<div class="space-y-6">
    <!-- Banner de Bienvenida -->
    <div class="p-6 rounded-2xl bg-gradient-to-r from-brand-600 to-brand-800 text-white shadow-card flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-emerald-200 text-xs font-semibold uppercase tracking-wider mb-1">
                <i data-lucide="store" class="w-4 h-4"></i> Minimarket Chininin SAC · Trujillo, Perú
            </div>
            <h1 class="text-2xl font-bold tracking-tight">¡Hola de nuevo, @userName!</h1>
            <p class="text-emerald-100 text-sm mt-0.5">
                Sesión activa con permisos de <strong class="underline decoration-emerald-300">@userRole</strong>.
            </p>
        </div>
        <div class="flex items-center gap-2">
            @if (userRole == "Administrador" || userRole == "Cajero")
            {
                <a asp-controller="Pos" asp-action="Index" class="px-4 py-2.5 rounded-xl bg-white text-brand-700 font-semibold text-sm hover:bg-emerald-50 transition shadow-sm inline-flex items-center gap-2">
                    <i data-lucide="shopping-cart" class="w-4 h-4"></i> Abrir POS
                </a>
            }
            @if (userRole == "Administrador" || userRole == "Almacenero")
            {
                <a asp-controller="Productos" asp-action="Index" class="px-4 py-2.5 rounded-xl bg-brand-700/80 hover:bg-brand-700 text-white font-semibold text-sm transition border border-white/20 inline-flex items-center gap-2">
                    <i data-lucide="package" class="w-4 h-4"></i> Gestionar Productos
                </a>
            }
        </div>
    </div>

    <!-- Tarjetas de Métricas en Tiempo Real (SQL Server) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Tarjeta 1: Productos -->
        <div class="card-chininin p-5">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Productos Activos</span>
                <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-600 grid place-items-center">
                    <i data-lucide="package" class="w-5 h-5"></i>
                </div>
            </div>
            <div class="mt-3">
                <div class="text-3xl font-extrabold text-slate-900">@Model.TotalProductos</div>
                <div class="text-xs text-slate-400 mt-1 flex items-center gap-1">
                    <i data-lucide="check-circle" class="w-3.5 h-3.5 text-brand-600"></i> En catálogo comercial
                </div>
            </div>
        </div>

        <!-- Tarjeta 2: Proveedores -->
        <div class="card-chininin p-5">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Proveedores Registrados</span>
                <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 grid place-items-center">
                    <i data-lucide="truck" class="w-5 h-5"></i>
                </div>
            </div>
            <div class="mt-3">
                <div class="text-3xl font-extrabold text-slate-900">@Model.TotalProveedores</div>
                <div class="text-xs text-slate-400 mt-1 flex items-center gap-1">
                    <i data-lucide="shield-check" class="w-3.5 h-3.5 text-blue-600"></i> RUCs SUNAT validados
                </div>
            </div>
        </div>

        <!-- Tarjeta 3: Categorías -->
        <div class="card-chininin p-5">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Categorías</span>
                <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 grid place-items-center">
                    <i data-lucide="tags" class="w-5 h-5"></i>
                </div>
            </div>
            <div class="mt-3">
                <div class="text-3xl font-extrabold text-slate-900">@Model.TotalCategorias</div>
                <div class="text-xs text-slate-400 mt-1 flex items-center gap-1">
                    <i data-lucide="layers" class="w-3.5 h-3.5 text-purple-600"></i> Clasificación por rubro
                </div>
            </div>
        </div>

        <!-- Tarjeta 4: Alertas de Stock -->
        <div class="card-chininin p-5 @(Model.ProductosStockBajo > 0 ? "border-amber-200 bg-amber-50/20" : "")">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Alertas de Stock</span>
                <div class="w-10 h-10 rounded-xl @(Model.ProductosStockBajo > 0 ? "bg-amber-100 text-amber-700" : "bg-emerald-50 text-emerald-600") grid place-items-center">
                    <i data-lucide="alert-triangle" class="w-5 h-5"></i>
                </div>
            </div>
            <div class="mt-3">
                <div class="text-3xl font-extrabold @(Model.ProductosStockBajo > 0 ? "text-amber-700" : "text-slate-900")">
                    @Model.ProductosStockBajo
                </div>
                <div class="text-xs text-slate-400 mt-1 flex items-center gap-1">
                    @if (Model.ProductosStockBajo > 0)
                    {
                        <span class="text-amber-700 font-medium flex items-center gap-1">
                            <i data-lucide="bell-ring" class="w-3.5 h-3.5"></i> Requiere abastecimiento
                        </span>
                    }
                    else
                    {
                        <span class="text-emerald-600 font-medium flex items-center gap-1">
                            <i data-lucide="check" class="w-3.5 h-3.5"></i> Stock en niveles óptimos
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Fila de Contenido: Alertas de Stock y Resumen Operativo -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Tabla de Alertas de Stock Mínimo -->
        <div class="lg:col-span-2 card-chininin p-5 space-y-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-lg bg-amber-50 text-amber-700 grid place-items-center">
                        <i data-lucide="alert-triangle" class="w-4 h-4"></i>
                    </div>
                    <div>
                        <h2 class="text-base font-bold text-slate-900">Productos con Stock Crítico</h2>
                        <p class="text-xs text-slate-400">Artículos cuyo stock es menor o igual al stock mínimo configurado</p>
                    </div>
                </div>
                <a asp-controller="Productos" asp-action="Index" class="text-xs font-semibold text-brand-600 hover:text-brand-700">
                    Ver todos &rarr;
                </a>
            </div>

            @if (Model.AlertasStock.Count == 0)
            {
                <div class="text-center py-12 text-slate-400 text-sm">
                    <i data-lucide="check-circle" class="w-10 h-10 mx-auto text-emerald-500 mb-2"></i>
                    Todos los productos cuentan con existencias suficientes en almacén.
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="table-chininin">
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th>Categoría</th>
                                <th class="text-center">Stock Actual</th>
                                <th class="text-center">Mínimo</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.AlertasStock)
                            {
                                <tr>
                                    <td>
                                        <div class="font-semibold text-slate-900">@item.Nombre</div>
                                        <div class="text-[11px] text-slate-400 font-mono">@item.CodigoBarras</div>
                                    </td>
                                    <td>
                                        <span class="badge-chininin bg-slate-100 text-slate-700">@item.Categoria</span>
                                    </td>
                                    <td class="text-center font-bold text-amber-700">
                                        @item.Stock.ToString("N1") @item.UnidadMedida
                                    </td>
                                    <td class="text-center text-slate-500">
                                        @item.StockMinimo.ToString("N1") @item.UnidadMedida
                                    </td>
                                    <td>
                                        <span class="badge-chininin bg-amber-100 text-amber-800">
                                            Reorden Inmediato
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- Panel Lateral: Accesos Directos según Rol -->
        <div class="card-chininin p-5 space-y-4">
            <h2 class="text-base font-bold text-slate-900">Accesos Rápidos</h2>
            <p class="text-xs text-slate-400">Operaciones frecuentes habilitadas para tu rol actual</p>

            <div class="space-y-2.5">
                @if (userRole == "Administrador" || userRole == "Cajero")
                {
                    <a asp-controller="Pos" asp-action="Index"
                       class="flex items-center justify-between p-3 rounded-xl border border-slate-100 hover:border-brand-300 hover:bg-brand-50/40 transition group no-underline">
                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-lg bg-emerald-50 text-emerald-700 grid place-items-center group-hover:bg-brand-600 group-hover:text-white transition">
                                <i data-lucide="shopping-cart" class="w-4 h-4"></i>
                            </div>
                            <div>
                                <div class="text-xs font-bold text-slate-800">Nueva Venta (POS)</div>
                                <div class="text-[11px] text-slate-400">Emisión de boleta rápida</div>
                            </div>
                        </div>
                        <i data-lucide="chevron-right" class="w-4 h-4 text-slate-300 group-hover:text-brand-600 transition"></i>
                    </a>
                }

                @if (userRole == "Administrador" || userRole == "Almacenero")
                {
                    <a asp-controller="Productos" asp-action="Index"
                       class="flex items-center justify-between p-3 rounded-xl border border-slate-100 hover:border-brand-300 hover:bg-brand-50/40 transition group no-underline">
                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-lg bg-blue-50 text-blue-700 grid place-items-center group-hover:bg-blue-600 group-hover:text-white transition">
                                <i data-lucide="package" class="w-4 h-4"></i>
                            </div>
                            <div>
                                <div class="text-xs font-bold text-slate-800">Catálogo de Productos</div>
                                <div class="text-[11px] text-slate-400">Precios, stock y códigos</div>
                            </div>
                        </div>
                        <i data-lucide="chevron-right" class="w-4 h-4 text-slate-300 group-hover:text-blue-600 transition"></i>
                    </a>

                    <a asp-controller="Proveedores" asp-action="Index"
                       class="flex items-center justify-between p-3 rounded-xl border border-slate-100 hover:border-brand-300 hover:bg-brand-50/40 transition group no-underline">
                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-lg bg-purple-50 text-purple-700 grid place-items-center group-hover:bg-purple-600 group-hover:text-white transition">
                                <i data-lucide="truck" class="w-4 h-4"></i>
                            </div>
                            <div>
                                <div class="text-xs font-bold text-slate-800">Registro de Proveedores</div>
                                <div class="text-[11px] text-slate-400">Abastecimiento y RUC</div>
                            </div>
                        </div>
                        <i data-lucide="chevron-right" class="w-4 h-4 text-slate-300 group-hover:text-purple-600 transition"></i>
                    </a>
                }
            </div>

            <!-- Ficha Técnica de la Solución -->
            <div class="pt-4 border-t border-slate-100 space-y-2 text-xs">
                <div class="flex justify-between text-slate-500">
                    <span>Arquitectura:</span>
                    <strong class="text-slate-800">Cliente - Servidor</strong>
                </div>
                <div class="flex justify-between text-slate-500">
                    <span>Motor BD:</span>
                    <strong class="text-slate-800">SQL Server (EF Core)</strong>
                </div>
                <div class="flex justify-between text-slate-500">
                    <span>Seguridad Activa:</span>
                    <strong class="text-slate-800">Cookie Auth + Claims</strong>
                </div>
            </div>
        </div>
    </div>
</div>
