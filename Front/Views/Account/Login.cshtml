@model Minimarket.Front.Models.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Iniciar Sesión - Minimarket Chininin SAC";
}

<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'system-ui', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            200: '#bbf7d0',
                            300: '#86efac',
                            400: '#4ade80',
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d',
                            800: '#166534',
                            900: '#14532d',
                        }
                    }
                }
            }
        }
    </script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        /* Animaciones fluidas de entrada */
        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(14px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        .anim-fade-up {
            opacity: 0;
            animation: fadeInUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
        .anim-delay-100 { animation-delay: 80ms; }
        .anim-delay-200 { animation-delay: 160ms; }
        .anim-delay-300 { animation-delay: 240ms; }
        .anim-delay-400 { animation-delay: 320ms; }

        /* Micro-pulso verde para feedback al inyectar credenciales */
        @@keyframes inputGlow {
            0% {
                border-color: #22c55e;
                box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.35);
                background-color: #f0fdf4;
            }
            100% {
                border-color: #e2e8f0;
                box-shadow: 0 0 0 0 rgba(34, 197, 94, 0);
                background-color: #ffffff;
            }
        }
        .input-pulse {
            animation: inputGlow 0.55s ease-out;
        }
    </style>
</head>
<body class="h-full bg-slate-50 text-slate-900 antialiased font-sans">
    <div class="min-h-screen grid lg:grid-cols-2">
        <!-- Panel Izquierdo: Branding y Propuesta de Valor (Retail Moderno) -->
        <div class="hidden lg:flex flex-col justify-between p-12 bg-gradient-to-br from-brand-600 via-brand-700 to-brand-800 text-white shadow-2xl relative overflow-hidden">
            <!-- Header Marca -->
            <div class="relative z-10 anim-fade-up">
                <div class="flex items-center gap-3">
                    <div class="w-12 h-12 rounded-2xl bg-white/15 backdrop-blur-md grid place-items-center shadow-inner hover:scale-105 transition-transform duration-200">
                        <i data-lucide="store" class="w-7 h-7 text-white"></i>
                    </div>
                    <div>
                        <div class="font-bold text-2xl tracking-tight leading-none">Chininin</div>
                        <div class="text-[11px] text-emerald-100/80 font-semibold tracking-widest uppercase mt-1">MINIMARKET SAC</div>
                    </div>
                </div>
            </div>

            <!-- Centro: Copywriting Opción A - Retail Moderno -->
            <div class="relative z-10 space-y-6 max-w-lg">
                <!-- Pill superior refinado -->
                <div class="anim-fade-up anim-delay-100">
                    <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-white/15 hover:bg-white/20 backdrop-blur-md text-white border border-white/15 transition shadow-sm">
                        <i data-lucide="sparkles" class="w-3.5 h-3.5 text-emerald-200"></i> Minimarket POS & Inventario
                    </span>
                </div>

                <!-- Título H1 con fuerza visual y jerarquía -->
                <div class="anim-fade-up anim-delay-200 space-y-3">
                    <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight leading-[1.12]">
                        Gestión simple.<br/>
                        <span class="text-emerald-200">Ventas más rápidas.</span>
                    </h1>
                    <p class="text-emerald-100/90 text-sm sm:text-base leading-relaxed max-w-md font-normal">
                        Control integral de stock, emisión ágil de comprobantes y auditoría en tiempo real para tu negocio.
                    </p>
                </div>

                <!-- 3 Tarjetas de Pilares de Valor con Microinteracción Hover -->
                <div class="anim-fade-up anim-delay-300 grid grid-cols-3 gap-3 pt-2">
                    <div class="group p-3.5 rounded-2xl bg-white/10 hover:bg-white/15 backdrop-blur-md border border-white/10 transition-all duration-200 hover:-translate-y-0.5 shadow-sm">
                        <div class="w-8 h-8 rounded-xl bg-white/15 grid place-items-center mb-2.5 group-hover:scale-110 transition-transform">
                            <i data-lucide="zap" class="w-4 h-4 text-emerald-200"></i>
                        </div>
                        <div class="text-xs font-bold text-white leading-tight">Punto de Venta</div>
                        <div class="text-[11px] text-emerald-100/75 mt-1 leading-snug">Cobros rápidos y boletas al instante</div>
                    </div>

                    <div class="group p-3.5 rounded-2xl bg-white/10 hover:bg-white/15 backdrop-blur-md border border-white/10 transition-all duration-200 hover:-translate-y-0.5 shadow-sm">
                        <div class="w-8 h-8 rounded-xl bg-white/15 grid place-items-center mb-2.5 group-hover:scale-110 transition-transform">
                            <i data-lucide="package-check" class="w-4 h-4 text-emerald-200"></i>
                        </div>
                        <div class="text-xs font-bold text-white leading-tight">Control de Stock</div>
                        <div class="text-[11px] text-emerald-100/75 mt-1 leading-snug">Alertas automáticas de mínimo</div>
                    </div>

                    <div class="group p-3.5 rounded-2xl bg-white/10 hover:bg-white/15 backdrop-blur-md border border-white/10 transition-all duration-200 hover:-translate-y-0.5 shadow-sm">
                        <div class="w-8 h-8 rounded-xl bg-white/15 grid place-items-center mb-2.5 group-hover:scale-110 transition-transform">
                            <i data-lucide="shield-check" class="w-4 h-4 text-emerald-200"></i>
                        </div>
                        <div class="text-xs font-bold text-white leading-tight">Seguridad</div>
                        <div class="text-[11px] text-emerald-100/75 mt-1 leading-snug">Permisos delimitados por rol</div>
                    </div>
                </div>
            </div>

            <!-- Footer Académico UPN -->
            <div class="anim-fade-up anim-delay-400 relative z-10 flex items-center justify-between text-xs text-emerald-100/80 pt-6 border-t border-white/10">
                <span>Curso: Diseño y Arquitectura de Software</span>
                <span class="flex items-center gap-1.5 font-semibold text-white">
                    <i data-lucide="graduation-cap" class="w-4 h-4 text-emerald-200"></i> UPN
                </span>
            </div>

            <!-- Círculos decorativos con efecto resplandor ambiental -->
            <div class="absolute -right-24 -bottom-24 w-96 h-96 rounded-full bg-emerald-400/10 blur-3xl pointer-events-none"></div>
            <div class="absolute -left-20 -top-20 w-80 h-80 rounded-full bg-brand-500/20 blur-3xl pointer-events-none"></div>
        </div>

        <!-- Panel Derecho: Formulario de Autenticación con Microinteracciones -->
        <div class="flex items-center justify-center p-6 sm:p-12">
            <div class="w-full max-w-md space-y-7 anim-fade-up anim-delay-100">
                <!-- Encabezado Móvil / Central -->
                <div class="text-center space-y-2">
                    <div class="lg:hidden inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-brand-600 text-white shadow-lg mb-2">
                        <i data-lucide="store" class="w-8 h-8"></i>
                    </div>
                    <h2 class="text-2xl font-bold tracking-tight text-slate-900">Bienvenido de nuevo</h2>
                    <p class="text-sm text-slate-500">Ingresa tus credenciales para acceder al sistema</p>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm flex items-start gap-3 anim-fade-up">
                        <i data-lucide="alert-circle" class="w-5 h-5 text-red-500 shrink-0 mt-0.5"></i>
                        <div asp-validation-summary="All" class="text-sm"></div>
                    </div>
                }

                <form id="formLogin" asp-action="Login" asp-controller="Account" method="post" class="space-y-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div>
                        <label asp-for="Usuario" class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1.5">Usuario</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                                <i data-lucide="user" class="w-4 h-4"></i>
                            </span>
                            <input asp-for="Usuario" id="inputUsuario" required autofocus autocomplete="username"
                                   placeholder="Ej: admin, almacen, cajero"
                                   class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 bg-white text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition text-sm font-medium" />
                        </div>
                        <span asp-validation-for="Usuario" class="text-xs text-red-600 mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="Password" class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1.5">Contraseña</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                                <i data-lucide="lock" class="w-4 h-4"></i>
                            </span>
                            <input asp-for="Password" id="inputPassword" type="password" required autocomplete="current-password"
                                   placeholder="••••••••"
                                   class="w-full pl-10 pr-10 py-2.5 rounded-xl border border-slate-200 bg-white text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition text-sm font-medium" />
                            <button type="button" onclick="togglePasswordVisibility()" class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-700 focus:outline-none cursor-pointer transition-transform duration-150" title="Mostrar/Ocultar contraseña">
                                <i id="iconoOjo" data-lucide="eye" class="w-4 h-4 transition-transform duration-150"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-xs text-red-600 mt-1 block"></span>
                    </div>

                    <button id="btnSubmit" type="submit"
                            class="w-full flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-brand-600 hover:bg-brand-700 active:scale-[0.98] text-white font-semibold text-sm transition-all duration-150 shadow-sm hover:shadow cursor-pointer disabled:opacity-75 disabled:pointer-events-none">
                        <span id="btnIcon"><i data-lucide="log-in" class="w-4 h-4"></i></span>
                        <span id="btnText">Iniciar Sesión</span>
                    </button>
                </form>

                <!-- Accesos Rápidos para Evaluación y Demo Académica con Microinteracción Táctil -->
                <div class="p-4 rounded-2xl bg-white border border-slate-200/80 shadow-sm space-y-3">
                    <div class="flex items-center justify-between text-xs text-slate-500 font-semibold uppercase tracking-wider">
                        <span>Usuarios de Prueba (1 Clic)</span>
                        <span class="text-[11px] text-slate-400 font-normal">Credenciales oficiales</span>
                    </div>
                    <div class="grid grid-cols-3 gap-2">
                        <button type="button" onclick="cargarCredencial('admin', this)"
                                class="px-2.5 py-2 rounded-xl bg-purple-50 hover:bg-purple-100 active:scale-95 text-purple-700 text-xs font-medium border border-purple-200/60 transition-all text-center cursor-pointer shadow-xs">
                            <strong class="font-semibold">Admin</strong><br><span class="text-[10px] opacity-75 font-mono">admin</span>
                        </button>
                        <button type="button" onclick="cargarCredencial('almacen', this)"
                                class="px-2.5 py-2 rounded-xl bg-blue-50 hover:bg-blue-100 active:scale-95 text-blue-700 text-xs font-medium border border-blue-200/60 transition-all text-center cursor-pointer shadow-xs">
                            <strong class="font-semibold">Almacén</strong><br><span class="text-[10px] opacity-75 font-mono">almacen</span>
                        </button>
                        <button type="button" onclick="cargarCredencial('cajero', this)"
                                class="px-2.5 py-2 rounded-xl bg-emerald-50 hover:bg-emerald-100 active:scale-95 text-emerald-700 text-xs font-medium border border-emerald-200/60 transition-all text-center cursor-pointer shadow-xs">
                            <strong class="font-semibold">Cajero</strong><br><span class="text-[10px] opacity-75 font-mono">cajero</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts de Microinteracciones y Comportamiento UX -->
    <script>
        lucide.createIcons();

        // 1. Alternar visibilidad de contraseña con micro-escala
        function togglePasswordVisibility() {
            const input = document.getElementById('inputPassword');
            const icon = document.getElementById('iconoOjo');

            icon.classList.add('scale-75');
            setTimeout(() => {
                if (input.type === 'password') {
                    input.type = 'text';
                    icon.setAttribute('data-lucide', 'eye-off');
                } else {
                    input.type = 'password';
                    icon.setAttribute('data-lucide', 'eye');
                }
                lucide.createIcons();
                icon.classList.remove('scale-75');
            }, 100);
        }

        // 2. Feedback de Carga al hacer clic en usuarios de prueba (Efecto Pulse)
        function cargarCredencial(usr, btn) {
            const inputUsr = document.getElementById('inputUsuario');
            const inputPass = document.getElementById('inputPassword');

            inputUsr.value = usr;
            inputPass.value = 'admin123';

            // Animación de pulso verde en los inputs
            [inputUsr, inputPass].forEach(el => {
                el.classList.remove('input-pulse');
                void el.offsetWidth; // reiniciar animación
                el.classList.add('input-pulse');
                setTimeout(() => el.classList.remove('input-pulse'), 550);
            });
        }

        // 3. Feedback visual al enviar formulario (Botón con estado de carga)
        const form = document.getElementById('formLogin');
        if (form) {
            form.addEventListener('submit', function () {
                const btn = document.getElementById('btnSubmit');
                const icon = document.getElementById('btnIcon');
                const text = document.getElementById('btnText');

                if (btn && icon && text) {
                    btn.disabled = true;
                    icon.innerHTML = '<i data-lucide="loader-2" class="w-4 h-4 animate-spin"></i>';
                    text.textContent = 'Verificando...';
                    lucide.createIcons();
                }
            });
        }
    </script>
</body>
</html>
