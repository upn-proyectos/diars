@using System.Security.Claims
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var userName = User.Identity?.Name ?? "Usuario Invitado";
    var userLogin = User.FindFirstValue(ClaimTypes.GivenName) ?? "invitado";
    var userRole = User.FindFirstValue(ClaimTypes.Role) ?? "Cajero";

    // Iniciales para avatar
    var initials = "CH";
    if (!string.IsNullOrWhiteSpace(userName))
    {
        var parts = userName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        initials = parts.Length >= 2 
            ? $"{parts[0][0]}{parts[1][0]}".ToUpper() 
            : parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
    }

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
}

<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Minimarket Chininin SAC</title>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'system-ui', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            200: '#bbf7d0',
                            300: '#86efac',
                            400: '#4ade80',
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d',
                            800: '#166534',
                            900: '#14532d',
                        }
                    },
                    boxShadow: {
                        card: '0 4px 24px -8px rgb(0 0 0 / 0.06)',
                    }
                }
            }
        }
    </script>

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <!-- Estilos Corporativos Chininin -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="h-full bg-slate-50 text-slate-900 antialiased font-sans flex">

    <!-- Mobile Drawer Overlay -->
    <div id="mobileOverlay" class="fixed inset-0 bg-black/40 z-40 hidden lg:hidden transition-opacity" onclick="toggleSidebar()"></div>

    <!-- Sidebar Lateral -->
    <aside id="sidebar" class="fixed lg:static inset-y-0 left-0 z-50 w-64 bg-white border-r border-slate-200/80 flex flex-col justify-between -translate-x-full lg:translate-x-0 transition-transform duration-200 ease-in-out shrink-0">
        <div>
            <!-- Header Marca -->
            <div class="h-16 flex items-center justify-between px-5 border-b border-slate-100">
                <a asp-controller="Home" asp-action="Index" class="flex items-center gap-3 no-underline">
                    <div class="w-10 h-10 rounded-xl bg-brand-600 text-white grid place-items-center shadow-sm shrink-0">
                        <i data-lucide="store" class="w-5 h-5"></i>
                    </div>
                    <div class="leading-tight">
                        <div class="font-bold text-slate-900 text-base">Chininin</div>
                        <div class="text-[11px] text-slate-400 font-semibold tracking-wider">MINIMARKET SAC</div>
                    </div>
                </a>
                <button type="button" class="lg:hidden p-1.5 text-slate-400 hover:text-slate-600 rounded-lg" onclick="toggleSidebar()">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <!-- Navegación Dinámica según el Rol Autenticado (Claims) -->
            <nav class="p-3 space-y-1 overflow-y-auto max-h-[calc(100vh-10rem)]">
                <!-- Dashboard / Inicio (Todos los roles) -->
                <a asp-controller="Home" asp-action="Index"
                   class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition @(currentController == "Home" && currentAction == "Index" ? "bg-brand-50 text-brand-700 font-semibold" : "text-slate-600 hover:bg-slate-50 hover:text-slate-900")">
                    <i data-lucide="layout-dashboard" class="w-4 h-4 @(currentController == "Home" && currentAction == "Index" ? "text-brand-600" : "text-slate-400")"></i>
                    <span>Dashboard</span>
                </a>

                @if (userRole == "Administrador" || userRole == "Cajero")
                {
                    <!-- Punto de Venta (POS) -->
                    <a asp-controller="Pos" asp-action="Index"
                       class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition @(currentController == "Pos" ? "bg-brand-50 text-brand-700 font-semibold" : "text-slate-600 hover:bg-slate-50 hover:text-slate-900")">
                        <i data-lucide="shopping-cart" class="w-4 h-4 @(currentController == "Pos" ? "text-brand-600" : "text-slate-400")"></i>
                        <span>Punto de Venta</span>
                    </a>
                }

                @if (userRole == "Administrador" || userRole == "Almacenero")
                {
                    <div class="pt-3 pb-1 px-3 text-[10px] font-bold uppercase tracking-wider text-slate-400">Inventario</div>
                    
                    <!-- Productos -->
                    <a asp-controller="Productos" asp-action="Index"
                       class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition @(currentController == "Productos" ? "bg-brand-50 text-brand-700 font-semibold" : "text-slate-600 hover:bg-slate-50 hover:text-slate-900")">
                        <i data-lucide="package" class="w-4 h-4 @(currentController == "Productos" ? "text-brand-600" : "text-slate-400")"></i>
                        <span>Productos</span>
                    </a>

                    <!-- Proveedores -->
                    <a asp-controller="Proveedores" asp-action="Index"
                       class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition @(currentController == "Proveedores" ? "bg-brand-50 text-brand-700 font-semibold" : "text-slate-600 hover:bg-slate-50 hover:text-slate-900")">
                        <i data-lucide="truck" class="w-4 h-4 @(currentController == "Proveedores" ? "text-brand-600" : "text-slate-400")"></i>
                        <span>Proveedores</span>
                    </a>
                }

                @if (userRole == "Administrador" || userRole == "Cajero")
                {
                    <div class="pt-3 pb-1 px-3 text-[10px] font-bold uppercase tracking-wider text-slate-400">Ventas y Clientes</div>

                    <!-- Clientes -->
                    <a asp-controller="Clientes" asp-action="Index"
                       class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition @(currentController == "Clientes" ? "bg-brand-50 text-brand-700 font-semibold" : "text-slate-600 hover:bg-slate-50 hover:text-slate-900")">
                        <i data-lucide="users-2" class="w-4 h-4 @(currentController == "Clientes" ? "text-brand-600" : "text-slate-400")"></i>
                        <span>Clientes</span>
                    </a>
                }

                @if (userRole == "Administrador")
                {
                    <div class="pt-3 pb-1 px-3 text-[10px] font-bold uppercase tracking-wider text-slate-400">Administración</div>

                    <!-- Kardex -->
                    <a asp-controller="Kardex" asp-action="Index"
                       class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition @(currentController == "Kardex" ? "bg-brand-50 text-brand-700 font-semibold" : "text-slate-600 hover:bg-slate-50 hover:text-slate-900")">
                        <i data-lucide="book-open" class="w-4 h-4 @(currentController == "Kardex" ? "text-brand-600" : "text-slate-400")"></i>
                        <span>Kardex</span>
                    </a>

                    <!-- Reportes -->
                    <a asp-controller="Reportes" asp-action="Index"
                       class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition @(currentController == "Reportes" ? "bg-brand-50 text-brand-700 font-semibold" : "text-slate-600 hover:bg-slate-50 hover:text-slate-900")">
                        <i data-lucide="bar-chart-3" class="w-4 h-4 @(currentController == "Reportes" ? "text-brand-600" : "text-slate-400")"></i>
                        <span>Reportes</span>
                    </a>
                }
            </nav>
        </div>

        <!-- Footer del Sidebar con Perfil Autenticado y Cerrar Sesión -->
        <div class="p-4 border-t border-slate-100 bg-slate-50/50">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3 min-w-0">
                    <div class="w-9 h-9 rounded-full bg-brand-100 text-brand-700 font-bold text-xs grid place-items-center shrink-0">
                        @initials
                    </div>
                    <div class="min-w-0">
                        <div class="text-xs font-bold text-slate-800 truncate">@userName</div>
                        <div class="text-[11px] text-slate-500 truncate">@userRole</div>
                    </div>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post" class="shrink-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" title="Cerrar Sesión" class="p-1.5 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition cursor-pointer">
                        <i data-lucide="log-out" class="w-4 h-4"></i>
                    </button>
                </form>
            </div>
        </div>
    </aside>

    <!-- Contenido Principal -->
    <div class="flex-1 flex flex-col min-w-0 min-h-screen">
        <!-- Top Navbar -->
        <header class="h-16 bg-white border-b border-slate-200/80 flex items-center justify-between px-4 lg:px-6 sticky top-0 z-30">
            <div class="flex items-center gap-3">
                <button type="button" class="lg:hidden p-2 text-slate-600 hover:bg-slate-100 rounded-xl" onclick="toggleSidebar()">
                    <i data-lucide="menu" class="w-5 h-5"></i>
                </button>
                <!-- Buscador rápido en header -->
                <div class="relative w-48 sm:w-72 hidden sm:block">
                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                        <i data-lucide="search" class="w-4 h-4"></i>
                    </span>
                    <input type="text" placeholder="Buscar producto o proveedor..."
                           class="w-full pl-9 pr-3 py-1.5 rounded-xl border border-slate-200 bg-slate-50 text-slate-800 text-xs placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:bg-white transition" />
                </div>
            </div>

            <!-- Información del Usuario Autenticado -->
            <div class="flex items-center gap-2 sm:gap-4">
                <div class="flex items-center gap-2">
                    @if (userRole == "Administrador")
                    {
                        <span class="badge-chininin badge-admin">
                            <i data-lucide="shield" class="w-3 h-3"></i> @userRole
                        </span>
                    }
                    else if (userRole == "Almacenero")
                    {
                        <span class="badge-chininin badge-almacen">
                            <i data-lucide="package" class="w-3 h-3"></i> @userRole
                        </span>
                    }
                    else
                    {
                        <span class="badge-chininin badge-cajero">
                            <i data-lucide="shopping-cart" class="w-3 h-3"></i> @userRole
                        </span>
                    }

                    <span class="badge-chininin bg-emerald-50 text-emerald-700 hidden sm:inline-flex">
                        <i data-lucide="circle" class="w-2 h-2 fill-current"></i> En Línea
                    </span>
                </div>

                <div class="h-6 w-px bg-slate-200 hidden sm:block"></div>

                <div class="flex items-center gap-2.5">
                    <div class="text-right hidden sm:block">
                        <div class="text-xs font-semibold text-slate-800">@userName</div>
                        <div class="text-[10px] text-slate-400 font-mono">@userLogin</div>
                    </div>
                    <div class="w-9 h-9 rounded-full bg-brand-100 text-brand-700 font-bold text-xs grid place-items-center">
                        @initials
                    </div>
                </div>
            </div>
        </header>

        <!-- Body Render -->
        <main class="flex-1 p-4 lg:p-6 overflow-x-hidden">
            @RenderBody()
        </main>

        <!-- Footer -->
        <footer class="py-3 px-6 bg-white border-t border-slate-200/80 text-center text-xs text-slate-400">
            Minimarket Chininin SAC &copy; 2026 — Arquitectura Cliente-Servidor (.NET 10 + SQL Server)
        </footer>
    </div>

    <!-- Scripts -->
    <script>
        lucide.createIcons();

        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('mobileOverlay');
            sidebar.classList.toggle('-translate-x-full');
            overlay.classList.toggle('hidden');
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
