@model Minimarket.Front.Models.KardexViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Auditoría de Kardex";
    var toastError = TempData["ToastError"] as string;
}

<div class="space-y-6">
    @if (!string.IsNullOrWhiteSpace(toastError))
    {
        <div class="flex items-center justify-between gap-3 px-4 py-3 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm shadow-sm">
            <div class="flex items-center gap-2.5">
                <i data-lucide="alert-circle" class="w-5 h-5 text-red-600 shrink-0"></i>
                <span class="font-medium">@toastError</span>
            </div>
        </div>
    }

    <!-- Encabezado Principal -->
    <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
            <div class="flex items-center gap-2">
                <h1 class="text-2xl font-bold text-slate-900">Kardex Físico y Auditoría</h1>
                <span class="badge-chininin bg-brand-50 text-brand-700 border border-brand-200 text-[11px]">
                    <i data-lucide="shield-check" class="w-3 h-3"></i> RF-02 · RF-08 Trazabilidad Transaccional
                </span>
            </div>
            <p class="text-slate-500 text-sm mt-1">
                Historial inmutable de entradas por compra, salidas por venta POS y ajustes manuales de inventario
            </p>
        </div>
    </div>

    <!-- Barra de Filtros de Consulta (Idéntica a Kardex.tsx) -->
    <form asp-controller="Kardex" asp-action="Index" method="get" class="card-chininin p-4 flex flex-wrap gap-3 items-center">
        <div class="relative flex-1 min-w-[240px]">
            <i data-lucide="package-search" class="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none"></i>
            <select name="productoId" class="input-chininin pl-10">
                <option value="">Todos los productos del catálogo (@Model.Productos.Count)</option>
                @foreach (var p in Model.Productos)
                {
                    <option value="@p.Id" selected="@(Model.ProductoIdFiltro == p.Id)">
                        @p.Nombre — (Stock actual: @p.Stock.ToString("0.###") @p.UnidadMedida)
                    </option>
                }
            </select>
        </div>

        <select name="tipo" class="input-chininin !w-auto min-w-[160px]">
            <option value="TODOS" selected="@(Model.TipoFiltro == "TODOS")">Todos los tipos</option>
            <option value="ENTRADA" selected="@(Model.TipoFiltro == "ENTRADA")">Entradas (+)</option>
            <option value="SALIDA" selected="@(Model.TipoFiltro == "SALIDA")">Salidas (-)</option>
            <option value="AJUSTE" selected="@(Model.TipoFiltro == "AJUSTE")">Ajustes (±)</option>
        </select>

        <div class="flex items-center gap-2">
            <input type="date" name="desde" value="@Model.Desde.ToString("yyyy-MM-dd")" class="input-chininin !w-auto text-xs font-mono" />
            <span class="text-xs text-slate-400">al</span>
            <input type="date" name="hasta" value="@Model.Hasta.ToString("yyyy-MM-dd")" class="input-chininin !w-auto text-xs font-mono" />
        </div>

        <button type="submit" class="btn-brand-primary">
            <i data-lucide="search" class="w-4 h-4"></i>
            <span>Consultar</span>
        </button>
    </form>

    <!-- Tarjetas KPI del Producto o Período -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        @if (Model.ProductoSeleccionado != null)
        {
            <div class="card-chininin p-4">
                <div class="text-xs text-slate-500 uppercase tracking-wide font-semibold">Stock actual</div>
                <div class="text-3xl font-bold text-slate-900 mt-1">@Model.ProductoSeleccionado.Stock.ToString("0.###")</div>
                <div class="text-xs text-slate-400 mt-0.5">@Model.ProductoSeleccionado.UnidadMedida</div>
            </div>
            <div class="card-chininin p-4">
                <div class="text-xs text-slate-500 uppercase tracking-wide font-semibold">Stock mínimo</div>
                <div class="text-3xl font-bold mt-1 @(Model.ProductoSeleccionado.EstaBajoStock ? "text-red-600" : "text-slate-900")">
                    @Model.ProductoSeleccionado.StockMinimo.ToString("0.###")
                </div>
                <div class="text-xs text-slate-400 mt-0.5">@Model.ProductoSeleccionado.UnidadMedida</div>
            </div>
        }
        else
        {
            <div class="card-chininin p-4">
                <div class="text-xs text-slate-500 uppercase tracking-wide font-semibold">Movimientos listados</div>
                <div class="text-3xl font-bold text-slate-900 mt-1">@Model.Movimientos.Count</div>
                <div class="text-xs text-slate-400 mt-0.5">Registros en el período</div>
            </div>
            <div class="card-chininin p-4">
                <div class="text-xs text-slate-500 uppercase tracking-wide font-semibold">Productos con movimiento</div>
                <div class="text-3xl font-bold text-slate-900 mt-1">@Model.Movimientos.Select(m => m.ProductoId).Distinct().Count()</div>
                <div class="text-xs text-slate-400 mt-0.5">Ítems auditados</div>
            </div>
        }

        <div class="card-chininin p-4">
            <div class="text-xs text-slate-500 uppercase tracking-wide font-semibold">Entradas (período)</div>
            <div class="text-3xl font-bold text-brand-600 mt-1">+@Model.TotalEntradasPeriodo.ToString("0.###")</div>
            <div class="text-xs text-slate-400 mt-0.5">Ingresos por órdenes de compra / ajustes</div>
        </div>

        <div class="card-chininin p-4">
            <div class="text-xs text-slate-500 uppercase tracking-wide font-semibold">Salidas (período)</div>
            <div class="text-3xl font-bold text-blue-600 mt-1">-@Model.TotalSalidasPeriodo.ToString("0.###")</div>
            <div class="text-xs text-slate-400 mt-0.5">Egresos por ventas POS / mermas</div>
        </div>
    </div>

    <!-- Tabla de Movimientos de Kardex -->
    <div class="card-chininin overflow-hidden">
        <div class="p-4 border-b border-slate-100 flex flex-wrap items-center justify-between gap-3">
            <h3 class="font-bold text-slate-900">
                Movimientos:
                <span class="text-brand-700">
                    @(Model.ProductoSeleccionado != null ? Model.ProductoSeleccionado.Nombre : "Vista Consolidada del Almacén")
                </span>
            </h3>

            <div class="flex items-center gap-3">
                <span class="text-xs font-semibold text-slate-500">@Model.Movimientos.Count registros</span>
                <button type="button"
                        onclick="exportarKardexCsv()"
                        disabled="@(Model.Movimientos.Count == 0)"
                        class="btn-brand-secondary !py-1.5 !text-xs disabled:opacity-40 cursor-pointer">
                    <i data-lucide="download" class="w-4 h-4"></i>
                    <span>Exportar CSV</span>
                </button>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="table-chininin">
                <thead>
                    <tr>
                        <th>Fecha y hora</th>
                        <th>Producto</th>
                        <th>Tipo</th>
                        <th>Documento</th>
                        <th>Motivo / Glosa</th>
                        <th>Usuario</th>
                        <th class="text-center">Cantidad</th>
                        <th class="text-right">Saldo resultante</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Movimientos.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center py-12 text-slate-400">
                                Sin movimientos registrados en el período seleccionado
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var m in Model.Movimientos)
                        {
                            var esEntrada = m.TipoMovimiento == "ENTRADA";
                            var esSalida = m.TipoMovimiento == "SALIDA";
                            var badgeCls = esEntrada
                                ? "bg-brand-50 text-brand-700 border border-brand-200"
                                : esSalida
                                    ? "bg-blue-50 text-blue-700 border border-blue-200"
                                    : "bg-amber-50 text-amber-700 border border-amber-200";
                            var iconName = esEntrada ? "arrow-up-circle" : esSalida ? "arrow-down-circle" : "refresh-cw";
                            var signo = esSalida || m.Cantidad < 0 ? "-" : "+";
                            var colorCant = esSalida || m.Cantidad < 0 ? "text-blue-600" : "text-brand-600";

                            <tr>
                                <td class="font-mono text-xs text-slate-500 whitespace-nowrap">@m.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <div class="font-semibold text-slate-900 text-xs">@m.ProductoNombre</div>
                                    @if (!string.IsNullOrWhiteSpace(m.ProductoCodigo))
                                    {
                                        <div class="text-[10px] font-mono text-slate-400">@m.ProductoCodigo</div>
                                    }
                                </td>
                                <td>
                                    <span class="badge-chininin @badgeCls">
                                        <i data-lucide="@iconName" class="w-3.5 h-3.5"></i>
                                        <span>@m.TipoMovimiento</span>
                                    </span>
                                </td>
                                <td class="font-mono font-semibold text-xs text-slate-800 whitespace-nowrap">@m.DocumentoReferencia</td>
                                <td class="text-xs text-slate-600">@m.Motivo</td>
                                <td class="text-xs text-slate-500">@m.UsuarioNombre</td>
                                <td class="text-center font-bold @colorCant whitespace-nowrap">
                                    @signo@Math.Abs(m.Cantidad).ToString("0.###")
                                </td>
                                <td class="text-right font-bold text-slate-900 whitespace-nowrap">
                                    @m.Saldo.ToString("0.###") <span class="text-[10px] font-normal text-slate-400">@(m.UnidadMedida == "KG" ? "kg" : "und")</span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const MOVIMIENTOS_KARDEX_CSV = @Html.Raw(JsonSerializer.Serialize(Model.Movimientos.Select(m => new {
        fecha = m.Fecha.ToString("yyyy-MM-dd HH:mm"),
        producto = m.ProductoNombre,
        tipo = m.TipoMovimiento,
        doc = m.DocumentoReferencia,
        motivo = m.Motivo,
        usuario = m.UsuarioNombre,
        cantidad = (m.TipoMovimiento == "SALIDA" || m.Cantidad < 0 ? "-" : "+") + Math.Abs(m.Cantidad).ToString("0.###"),
        saldo = m.Saldo.ToString("0.###")
    })));

    function exportarKardexCsv() {
        if (!MOVIMIENTOS_KARDEX_CSV || MOVIMIENTOS_KARDEX_CSV.length === 0) return;

        const cabeceras = ['Fecha y Hora', 'Producto', 'Tipo', 'Documento', 'Motivo', 'Usuario', 'Cantidad', 'Saldo'];
        const filas = [
            cabeceras.join(','),
            ...MOVIMIENTOS_KARDEX_CSV.map(m => [
                `"${m.fecha}"`,
                `"${(m.producto || '').replace(/"/g, '""')}"`,
                `"${m.tipo}"`,
                `"${m.doc}"`,
                `"${(m.motivo || '').replace(/"/g, '""')}"`,
                `"${(m.usuario || '').replace(/"/g, '""')}"`,
                m.cantidad,
                m.saldo
            ].join(','))
        ];

        const contenido = '\uFEFF' + filas.join('\n');
        const blob = new Blob([contenido], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `kardex-chininin-${new Date().toISOString().slice(0, 10)}.csv`;
        a.click();
        URL.revokeObjectURL(url);
    }
</script>
}
