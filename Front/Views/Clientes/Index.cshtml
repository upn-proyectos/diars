@model List<Minimarket.Negocio.DTOs.ClienteDto>
@{
    ViewData["Title"] = "Directorio de Clientes";
    var toastExito = TempData["ToastExito"] as string;
    var toastError = TempData["ToastError"] as string;
    var totalDni = Model.Count(c => c.TipoDoc == "DNI" && !c.EsPublicoGeneral);
    var totalRuc = Model.Count(c => c.TipoDoc == "RUC");
}

<div class="space-y-6">
    <!-- Notificaciones Toast -->
    @if (!string.IsNullOrWhiteSpace(toastExito))
    {
        <div id="toastCliExito" class="flex items-center justify-between gap-3 px-4 py-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm shadow-sm">
            <div class="flex items-center gap-2.5">
                <i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-600 shrink-0"></i>
                <span class="font-medium">@toastExito</span>
            </div>
            <button type="button" onclick="document.getElementById('toastCliExito')?.remove()" class="text-emerald-600 hover:text-emerald-800 p-1">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(toastError))
    {
        <div id="toastCliError" class="flex items-center justify-between gap-3 px-4 py-3 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm shadow-sm">
            <div class="flex items-center gap-2.5">
                <i data-lucide="alert-circle" class="w-5 h-5 text-red-600 shrink-0"></i>
                <span class="font-medium">@toastError</span>
            </div>
            <button type="button" onclick="document.getElementById('toastCliError')?.remove()" class="text-red-600 hover:text-red-800 p-1">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>
    }

    <!-- Encabezado Principal (Idéntico a Clientes.tsx) -->
    <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
            <div class="flex items-center gap-2">
                <h1 class="text-2xl font-bold text-slate-900">Clientes</h1>
                <span class="badge-chininin bg-blue-50 text-blue-700 border border-blue-200 text-[11px]">
                    <i data-lucide="plug-zap" class="w-3 h-3"></i> Patrón Adapter (DNI 8 / RUC 11)
                </span>
            </div>
            <p class="text-slate-500 text-sm mt-1">
                <span id="lblTotalClientes">@Model.Count</span> clientes registrados · @totalDni con DNI · @totalRuc con RUC
            </p>
        </div>

        <button type="button" onclick="abrirModalNuevoCliente()" class="btn-brand-primary">
            <i data-lucide="plus" class="w-4 h-4"></i>
            <span>Nuevo cliente</span>
        </button>
    </div>

    <!-- Buscador -->
    <div class="card-chininin p-4">
        <div class="relative">
            <i data-lucide="search" class="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none"></i>
            <input id="inputBuscarCliente" type="text" oninput="filtrarClientes()"
                   placeholder="Buscar por nombre, razón social, DNI, RUC o teléfono..."
                   class="input-chininin pl-10" />
        </div>
    </div>

    <!-- Tabla de Clientes -->
    <div class="card-chininin overflow-hidden">
        <div class="overflow-x-auto">
            <table class="table-chininin">
                <thead>
                    <tr>
                        <th>Documento</th>
                        <th>Nombre / Razón Social</th>
                        <th>Clasificación</th>
                        <th>Teléfono</th>
                        <th>Dirección</th>
                        <th class="text-right">Compras</th>
                        <th class="text-right">Acciones</th>
                    </tr>
                </thead>
                <tbody id="tbodyClientes">
                    @foreach (var c in Model)
                    {
                        var textoBusqueda = $"{c.NombreCompleto} {c.Documento} {c.TipoDoc} {c.Telefono} {c.Direccion}".ToLower();
                        <tr class="fila-cliente" data-busqueda="@textoBusqueda">
                            <td>
                                <div class="flex items-center gap-2">
                                    <i data-lucide="credit-card" class="w-3.5 h-3.5 text-slate-400 shrink-0"></i>
                                    <span class="font-mono text-sm font-semibold text-slate-800">@c.Documento</span>
                                    <span class="badge-chininin @(c.TipoDoc == "RUC" ? "bg-purple-50 text-purple-700" : "bg-slate-100 text-slate-600") text-[10px]">
                                        @c.TipoDoc
                                    </span>
                                </div>
                            </td>
                            <td class="font-semibold text-slate-900">@c.NombreCompleto</td>
                            <td>
                                <span class="badge-chininin bg-emerald-50 text-emerald-700 text-[11px]">
                                    <i data-lucide="shield-check" class="w-3 h-3"></i> @c.TipoContribuyente
                                </span>
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(c.Telefono) && c.Telefono != "-")
                                {
                                    <div class="flex items-center gap-1.5 text-slate-600 text-sm">
                                        <i data-lucide="phone" class="w-3.5 h-3.5 text-slate-400"></i>
                                        <span>@c.Telefono</span>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-slate-400">—</span>
                                }
                            </td>
                            <td class="text-slate-600 text-sm max-w-[220px] truncate">
                                @(string.IsNullOrWhiteSpace(c.Direccion) || c.Direccion == "-" ? "—" : c.Direccion)
                            </td>
                            <td class="text-right">
                                <span class="text-xs font-semibold text-slate-700">@c.TotalComprasRealizadas</span>
                                @if (c.MontoTotalHistorico > 0)
                                {
                                    <span class="block text-[11px] text-brand-700 font-medium">S/ @c.MontoTotalHistorico.ToString("0.00")</span>
                                }
                            </td>
                            <td class="text-right">
                                @if (!c.EsPublicoGeneral)
                                {
                                    <div class="flex gap-1 justify-end">
                                        <button type="button"
                                                title="Editar cliente"
                                                onclick="abrirModalEditarCliente(@c.Id, '@c.TipoDoc', '@Html.Raw(c.Documento.Replace("'", "\\'"))', '@Html.Raw(c.NombreCompleto.Replace("'", "\\'"))', '@Html.Raw((c.Telefono ?? "").Replace("'", "\\'"))', '@Html.Raw((c.Direccion ?? "").Replace("'", "\\'"))')"
                                                class="btn-brand-ghost p-1.5">
                                            <i data-lucide="pencil" class="w-4 h-4"></i>
                                        </button>
                                        <button type="button"
                                                title="Retirar cliente"
                                                onclick="abrirModalEliminarCliente(@c.Id, '@Html.Raw(c.NombreCompleto.Replace("'", "\\'"))')"
                                                class="btn-brand-ghost p-1.5 text-red-500 hover:bg-red-50 hover:text-red-600">
                                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-[11px] text-slate-400 italic">Predeterminado</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div id="sinResultadosClientes" class="hidden text-center py-10 text-slate-400 text-sm">
            No se encontraron clientes que coincidan con tu búsqueda.
        </div>
    </div>
</div>

<!-- Modal Crear / Editar Cliente -->
<div id="modalCliente" class="fixed inset-0 bg-black/40 backdrop-blur-sm z-50 hidden items-center justify-center p-4" style="margin-top:0 !important;">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-md overflow-hidden">
        <div class="flex items-center justify-between p-5 border-b border-slate-100">
            <div>
                <h2 id="tituloModalCliente" class="font-bold text-slate-900 text-lg">Nuevo cliente</h2>
                <p class="text-xs text-slate-400 mt-0.5">Validación RENIEC (DNI 8 dígitos) y SUNAT (RUC 11 dígitos)</p>
            </div>
            <button type="button" onclick="cerrarModalCliente()" class="btn-brand-ghost p-1.5">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>

        <form asp-controller="Clientes" asp-action="Guardar" method="post" onsubmit="return validarFormularioCliente()">
            @Html.AntiForgeryToken()
            <input type="hidden" id="cliId" name="Id" value="" />

            <div class="p-5 space-y-4">
                <p class="text-xs text-slate-400"><span class="text-red-500">*</span> Campos obligatorios</p>

                <div class="grid grid-cols-3 gap-3">
                    <div>
                        <label for="cliTipoDoc" class="block text-xs font-semibold text-slate-700 mb-1">Tipo Doc.</label>
                        <select id="cliTipoDoc" name="TipoDoc" onchange="cambiarTipoDocCliente()" class="input-chininin">
                            <option value="DNI">DNI (8)</option>
                            <option value="RUC">RUC (11)</option>
                        </select>
                    </div>
                    <div class="col-span-2">
                        <label for="cliDocumento" class="block text-xs font-semibold text-slate-700 mb-1">
                            N° de Documento <span class="text-red-500">*</span>
                        </label>
                        <input id="cliDocumento" name="Documento" type="text" maxlength="8"
                               oninput="this.value = this.value.replace(/\D/g, ''); validarDocEnVivo();"
                               placeholder="8 dígitos numéricos"
                               class="input-chininin font-mono" required />
                        <p id="errCliDoc" class="hidden items-center gap-1 text-xs text-red-500 mt-1"></p>
                        <p id="okCliDoc" class="hidden items-center gap-1 text-xs text-emerald-600 mt-1"></p>
                    </div>
                </div>

                <div>
                    <label for="cliNombre" class="block text-xs font-semibold text-slate-700 mb-1">
                        Nombre completo o Razón Social <span class="text-red-500">*</span>
                    </label>
                    <input id="cliNombre" name="NombreCompleto" type="text" maxlength="150"
                           placeholder="Ej: María Fernanda García López"
                           class="input-chininin" required />
                    <p id="errCliNombre" class="hidden text-xs text-red-500 mt-1"></p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label for="cliTelefono" class="block text-xs font-semibold text-slate-700 mb-1">Teléfono</label>
                        <input id="cliTelefono" name="Telefono" type="text" maxlength="20"
                               placeholder="9xxxxxxxx" class="input-chininin" />
                    </div>
                    <div>
                        <label for="cliDireccion" class="block text-xs font-semibold text-slate-700 mb-1">Dirección</label>
                        <input id="cliDireccion" name="Direccion" type="text" maxlength="200"
                               placeholder="Av. / Jr. / Urb." class="input-chininin" />
                    </div>
                </div>
            </div>

            <div class="flex gap-3 p-5 border-t border-slate-100 bg-slate-50/50">
                <button type="button" onclick="cerrarModalCliente()" class="btn-brand-secondary flex-1 justify-center">Cancelar</button>
                <button type="submit" class="btn-brand-primary flex-1 justify-center">
                    <i data-lucide="check" class="w-4 h-4"></i>
                    <span id="txtBtnGuardarCliente">Registrar</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Confirmar Eliminación -->
<div id="modalEliminarCliente" class="fixed inset-0 bg-black/40 backdrop-blur-sm z-50 hidden items-center justify-center p-4" style="margin-top:0 !important;">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-sm p-6 text-center">
        <div class="w-12 h-12 rounded-full bg-red-50 grid place-items-center mx-auto mb-4 text-red-500">
            <i data-lucide="trash-2" class="w-6 h-6"></i>
        </div>
        <h3 class="font-bold text-slate-900 text-lg">¿Retirar cliente?</h3>
        <p class="text-slate-500 text-sm mt-1 mb-5">
            Se retirará a <strong id="lblNombreEliminarCliente" class="text-slate-800"></strong> del directorio activo.
        </p>
        <form asp-controller="Clientes" asp-action="Eliminar" method="post" class="flex gap-3">
            @Html.AntiForgeryToken()
            <input type="hidden" id="idEliminarCliente" name="id" value="" />
            <button type="button" onclick="cerrarModalEliminarCliente()" class="btn-brand-secondary flex-1 justify-center">Cancelar</button>
            <button type="submit" class="btn-brand-primary !bg-red-600 hover:!bg-red-700 flex-1 justify-center">Eliminar</button>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function filtrarClientes() {
        const q = (document.getElementById('inputBuscarCliente').value || '').toLowerCase().trim();
        const filas = document.querySelectorAll('.fila-cliente');
        let visibles = 0;

        filas.forEach(tr => {
            const texto = tr.getAttribute('data-busqueda') || '';
            const coincide = !q || texto.includes(q);
            tr.classList.toggle('hidden', !coincide);
            if (coincide) visibles++;
        });

        document.getElementById('sinResultadosClientes').classList.toggle('hidden', visibles > 0);
    }

    function cambiarTipoDocCliente() {
        const tipo = document.getElementById('cliTipoDoc').value;
        const input = document.getElementById('cliDocumento');
        input.maxLength = tipo === 'DNI' ? 8 : 11;
        input.placeholder = tipo === 'DNI' ? '8 dígitos numéricos' : '11 dígitos (10 o 20...)';
        if (input.value.length > input.maxLength) {
            input.value = input.value.substring(0, input.maxLength);
        }
        validarDocEnVivo();
    }

    function validarDocEnVivo() {
        const tipo = document.getElementById('cliTipoDoc').value;
        const doc = document.getElementById('cliDocumento').value.trim();
        const err = document.getElementById('errCliDoc');
        const ok = document.getElementById('okCliDoc');

        err.classList.add('hidden');
        ok.classList.add('hidden');

        if (!doc) return true;

        if (tipo === 'DNI') {
            if (doc.length !== 8) {
                err.textContent = 'El DNI debe contener exactamente 8 dígitos.';
                err.classList.remove('hidden');
                return false;
            }
            ok.textContent = '✓ Formato DNI válido (RENIEC 8 dígitos)';
            ok.classList.remove('hidden');
            return true;
        } else {
            if (doc.length !== 11 || (!doc.startsWith('10') && !doc.startsWith('15') && !doc.startsWith('17') && !doc.startsWith('20'))) {
                err.textContent = 'El RUC debe tener 11 dígitos e iniciar con 10, 15, 17 o 20.';
                err.classList.remove('hidden');
                return false;
            }
            ok.textContent = doc.startsWith('20') ? '✓ Persona Jurídica (RUC 20)' : '✓ Persona Natural con Negocio (RUC 10)';
            ok.classList.remove('hidden');
            return true;
        }
    }

    function validarFormularioCliente() {
        const docOk = validarDocEnVivo();
        const nombre = document.getElementById('cliNombre').value.trim();
        const errNom = document.getElementById('errCliNombre');

        if (nombre.length < 3) {
            errNom.textContent = 'Ingrese al menos 3 caracteres.';
            errNom.classList.remove('hidden');
            return false;
        }
        errNom.classList.add('hidden');
        return docOk;
    }

    function abrirModalNuevoCliente() {
        document.getElementById('cliId').value = '';
        document.getElementById('cliTipoDoc').value = 'DNI';
        document.getElementById('cliDocumento').value = '';
        document.getElementById('cliNombre').value = '';
        document.getElementById('cliTelefono').value = '';
        document.getElementById('cliDireccion').value = '';
        document.getElementById('tituloModalCliente').textContent = 'Nuevo cliente';
        document.getElementById('txtBtnGuardarCliente').textContent = 'Registrar';
        cambiarTipoDocCliente();

        const modal = document.getElementById('modalCliente');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    }

    function abrirModalEditarCliente(id, tipoDoc, documento, nombre, telefono, direccion) {
        document.getElementById('cliId').value = id;
        document.getElementById('cliTipoDoc').value = tipoDoc || 'DNI';
        cambiarTipoDocCliente();
        document.getElementById('cliDocumento').value = documento;
        document.getElementById('cliNombre').value = nombre;
        document.getElementById('cliTelefono').value = telefono === '-' ? '' : telefono;
        document.getElementById('cliDireccion').value = direccion === '-' ? '' : direccion;
        document.getElementById('tituloModalCliente').textContent = 'Editar cliente';
        document.getElementById('txtBtnGuardarCliente').textContent = 'Guardar cambios';
        validarDocEnVivo();

        const modal = document.getElementById('modalCliente');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    }

    function cerrarModalCliente() {
        const modal = document.getElementById('modalCliente');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
    }

    function abrirModalEliminarCliente(id, nombre) {
        document.getElementById('idEliminarCliente').value = id;
        document.getElementById('lblNombreEliminarCliente').textContent = nombre;
        const modal = document.getElementById('modalEliminarCliente');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    }

    function cerrarModalEliminarCliente() {
        const modal = document.getElementById('modalEliminarCliente');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
    }
</script>
}
