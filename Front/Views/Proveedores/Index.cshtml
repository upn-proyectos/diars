@model List<Minimarket.Negocio.DTOs.ProveedorDto>
@{
    ViewData["Title"] = "Directorio de Proveedores";
    var toastExito = TempData["ToastExito"] as string;
    var toastError = TempData["ToastError"] as string;
}

<div class="space-y-6">
    <!-- Notificaciones Toast -->
    @if (!string.IsNullOrWhiteSpace(toastExito))
    {
        <div id="toastProvExito" class="flex items-center justify-between gap-3 px-4 py-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm shadow-sm">
            <div class="flex items-center gap-2.5">
                <i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-600 shrink-0"></i>
                <span class="font-medium">@toastExito</span>
            </div>
            <button type="button" onclick="document.getElementById('toastProvExito')?.remove()" class="text-emerald-600 hover:text-emerald-800 p-1">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(toastError))
    {
        <div id="toastProvError" class="flex items-center justify-between gap-3 px-4 py-3 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm shadow-sm">
            <div class="flex items-center gap-2.5">
                <i data-lucide="alert-circle" class="w-5 h-5 text-red-600 shrink-0"></i>
                <span class="font-medium">@toastError</span>
            </div>
            <button type="button" onclick="document.getElementById('toastProvError')?.remove()" class="text-red-600 hover:text-red-800 p-1">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>
    }

    <!-- Encabezado Principal (Idéntico a Proveedores.tsx) -->
    <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
            <div class="flex items-center gap-2">
                <h1 class="text-2xl font-bold text-slate-900">Proveedores</h1>
                <span class="badge-chininin bg-blue-50 text-blue-700 border border-blue-200 text-[11px]">
                    <i data-lucide="plug-zap" class="w-3 h-3"></i> Patrón Adapter (SUNAT RUC 11)
                </span>
            </div>
            <p class="text-slate-500 text-sm mt-1">
                <span id="lblTotalProveedores">@Model.Count</span> proveedores registrados y validados
            </p>
        </div>

        <button type="button" onclick="abrirModalNuevoProveedor()" class="btn-brand-primary">
            <i data-lucide="plus" class="w-4 h-4"></i>
            <span>Nuevo proveedor</span>
        </button>
    </div>

    <!-- Barra de Búsqueda (Igual a Proveedores.tsx) -->
    <div class="card-chininin p-4">
        <div class="relative">
            <i data-lucide="search" class="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none"></i>
            <input id="inputBuscarProveedor" type="text" oninput="filtrarProveedores()"
                   placeholder="Buscar por razón social, nombre comercial, RUC o persona de contacto..."
                   class="input-chininin pl-10" />
        </div>
    </div>

    <!-- Grid de Tarjetas de Proveedores (Idéntico a Proveedores.tsx) -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4" id="gridProveedores">
        @foreach (var p in Model)
        {
            var textoBusqueda = $"{p.RazonSocial} {p.NombreComercial} {p.Ruc} {p.Contacto}".ToLower();

            <div class="card-chininin p-5 hover:shadow-md transition-shadow tarjeta-proveedor flex flex-col justify-between"
                 data-busqueda="@textoBusqueda">
                <div>
                    <div class="flex items-start justify-between gap-3">
                        <div class="w-11 h-11 rounded-xl bg-brand-50 grid place-items-center shrink-0">
                            <i data-lucide="building-2" class="w-5 h-5 text-brand-700"></i>
                        </div>
                        <div class="flex gap-1 shrink-0">
                            <button type="button"
                                    title="Editar proveedor"
                                    onclick="abrirModalEditarProveedor(@p.Id, '@Html.Raw(p.Ruc.Replace("'", "\\'"))', '@Html.Raw(p.RazonSocial.Replace("'", "\\'"))', '@Html.Raw((p.NombreComercial ?? "").Replace("'", "\\'"))', '@Html.Raw((p.Contacto ?? "").Replace("'", "\\'"))', '@Html.Raw((p.Telefono ?? "").Replace("'", "\\'"))', '@Html.Raw((p.Email ?? "").Replace("'", "\\'"))', '@Html.Raw((p.Direccion ?? "").Replace("'", "\\'"))')"
                                    class="btn-brand-ghost p-1.5">
                                <i data-lucide="pencil" class="w-4 h-4"></i>
                            </button>
                            <button type="button"
                                    title="Eliminar proveedor"
                                    onclick="abrirModalEliminarProveedor(@p.Id, '@Html.Raw(p.NombreMostrar.Replace("'", "\\'"))')"
                                    class="btn-brand-ghost p-1.5 text-red-500 hover:bg-red-50 hover:text-red-600">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </div>

                    <div class="mt-3">
                        <h3 class="font-bold text-slate-900 text-base">@p.NombreMostrar</h3>
                        @if (!string.IsNullOrWhiteSpace(p.NombreComercial))
                        {
                            <p class="text-xs text-slate-400 mt-0.5">@p.RazonSocial</p>
                        }

                        <div class="mt-3 space-y-1.5 text-sm text-slate-600">
                            <div class="flex items-center justify-between gap-2">
                                <div class="flex items-center gap-2">
                                    <i data-lucide="hash" class="w-3.5 h-3.5 text-slate-400 shrink-0"></i>
                                    <span>RUC: <span class="font-mono font-semibold text-slate-800">@p.Ruc</span></span>
                                </div>
                                <span class="badge-chininin bg-emerald-50 text-emerald-700 text-[10px]">
                                    <i data-lucide="shield-check" class="w-3 h-3"></i> SUNAT
                                </span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(p.Contacto) || !string.IsNullOrWhiteSpace(p.Telefono))
                            {
                                <div class="flex items-center gap-2">
                                    <i data-lucide="phone" class="w-3.5 h-3.5 text-slate-400 shrink-0"></i>
                                    <span class="truncate">
                                        @(string.IsNullOrWhiteSpace(p.Contacto) ? "" : p.Contacto)@(!string.IsNullOrWhiteSpace(p.Contacto) && !string.IsNullOrWhiteSpace(p.Telefono) ? " · " : "")@(p.Telefono ?? "")
                                    </span>
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(p.Email))
                            {
                                <div class="flex items-center gap-2 min-w-0">
                                    <i data-lucide="mail" class="w-3.5 h-3.5 text-slate-400 shrink-0"></i>
                                    <span class="truncate">@p.Email</span>
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(p.Direccion))
                            {
                                <div class="flex items-center gap-2 min-w-0 text-xs text-slate-400">
                                    <i data-lucide="map-pin" class="w-3.5 h-3.5 text-slate-400 shrink-0"></i>
                                    <span class="truncate">@p.Direccion</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Pie de Tarjeta con Clasificación Adapter y Productos Abastecidos -->
                <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
                    <span class="text-slate-400">@p.TipoContribuyente</span>
                    <span class="font-semibold text-brand-700 bg-brand-50 px-2 py-0.5 rounded-full">
                        @p.TotalProductosAbastecidos prod.
                    </span>
                </div>
            </div>
        }

        <div id="sinProveedoresMsg" class="@(Model.Count == 0 ? "" : "hidden") md:col-span-2 xl:col-span-3 text-center py-16 text-slate-400 card-chininin">
            <i data-lucide="truck" class="w-9 h-9 text-slate-300 mx-auto mb-2"></i>
            <div>No se encontraron proveedores que coincidan con la búsqueda</div>
        </div>
    </div>
</div>

<!-- =======================================================================
     MODAL CREAR / EDITAR PROVEEDOR (CON VALIDACIÓN ADAPTER RUC 11 DÍGITOS)
     ======================================================================= -->
<div id="modalProveedor" class="fixed inset-0 bg-black/40 backdrop-blur-sm z-50 hidden place-items-center p-4">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-md max-h-[92vh] flex flex-col overflow-hidden">
        <div class="flex items-center justify-between p-5 border-b border-slate-100 shrink-0">
            <h2 id="modalProveedorTitulo" class="font-bold text-slate-900 text-lg">Nuevo proveedor</h2>
            <button type="button" onclick="cerrarModalProveedor()" class="btn-brand-ghost p-1.5">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>

        <form asp-controller="Proveedores" asp-action="Guardar" method="post" onsubmit="return validarFormularioProveedor()" class="flex-1 overflow-y-auto flex flex-col justify-between">
            @Html.AntiForgeryToken()
            <input type="hidden" id="provId" name="Id" value="" />

            <div class="p-5 space-y-4 overflow-y-auto">
                <p class="text-xs text-slate-400"><span class="text-red-500">*</span> Campos obligatorios validados por <code class="text-brand-700 font-mono">IValidadorDocumentoAdapter</code></p>

                <!-- RUC -->
                <div>
                    <label for="provRuc" class="block text-sm font-medium text-slate-700 mb-1">
                        RUC (11 dígitos SUNAT) <span class="text-red-500">*</span>
                    </label>
                    <input id="provRuc" name="Ruc" type="text" maxlength="11" required
                           oninput="validarRucEnVivo()"
                           placeholder="20xxxxxxxxx o 10xxxxxxxxx"
                           class="input-chininin font-mono" />
                    <p id="feedbackRucAdapter" class="text-xs mt-1 hidden"></p>
                </div>

                <!-- Razón Social -->
                <div>
                    <label for="provRazonSocial" class="block text-sm font-medium text-slate-700 mb-1">
                        Razón social <span class="text-red-500">*</span>
                    </label>
                    <input id="provRazonSocial" name="RazonSocial" type="text" required minlength="3"
                           placeholder="Ej: Leche Gloria S.A."
                           class="input-chininin" />
                </div>

                <!-- Nombre Comercial -->
                <div>
                    <label for="provNombreComercial" class="block text-sm font-medium text-slate-700 mb-1">
                        Nombre comercial
                    </label>
                    <input id="provNombreComercial" name="NombreComercial" type="text"
                           placeholder="Ej: Gloria"
                           class="input-chininin" />
                </div>

                <!-- Persona de Contacto -->
                <div>
                    <label for="provContacto" class="block text-sm font-medium text-slate-700 mb-1">
                        Persona de contacto
                    </label>
                    <input id="provContacto" name="Contacto" type="text"
                           placeholder="Ej: Luis Pérez"
                           class="input-chininin" />
                </div>

                <!-- Teléfono -->
                <div>
                    <label for="provTelefono" class="block text-sm font-medium text-slate-700 mb-1">
                        Teléfono
                    </label>
                    <input id="provTelefono" name="Telefono" type="text"
                           placeholder="9xxxxxxxx"
                           class="input-chininin" />
                </div>

                <!-- Correo Electrónico -->
                <div>
                    <label for="provEmail" class="block text-sm font-medium text-slate-700 mb-1">
                        Correo electrónico
                    </label>
                    <input id="provEmail" name="Email" type="email"
                           placeholder="ventas@empresa.pe"
                           class="input-chininin" />
                </div>

                <!-- Dirección -->
                <div>
                    <label for="provDireccion" class="block text-sm font-medium text-slate-700 mb-1">
                        Dirección
                    </label>
                    <input id="provDireccion" name="Direccion" type="text"
                           placeholder="Av. Principal 123 - Trujillo"
                           class="input-chininin" />
                </div>
            </div>

            <div class="flex gap-3 p-5 border-t border-slate-100 bg-slate-50/50 shrink-0">
                <button type="button" onclick="cerrarModalProveedor()" class="btn-brand-secondary flex-1">
                    Cancelar
                </button>
                <button type="submit" id="btnGuardarProveedor" class="btn-brand-primary flex-1">
                    Registrar
                </button>
            </div>
        </form>
    </div>
</div>

<!-- =======================================================================
     MODAL CONFIRMAR ELIMINACIÓN DE PROVEEDOR
     ======================================================================= -->
<div id="modalEliminarProveedor" class="fixed inset-0 bg-black/40 backdrop-blur-sm z-50 hidden place-items-center p-4">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-sm p-6 text-center">
        <div class="w-12 h-12 rounded-full bg-red-50 grid place-items-center mx-auto mb-4">
            <i data-lucide="trash-2" class="w-6 h-6 text-red-500"></i>
        </div>
        <h3 class="font-bold text-slate-900 text-lg">¿Retirar proveedor?</h3>
        <p class="text-slate-500 text-sm mt-1 mb-5">
            Se retirará a <strong id="eliminarProveedorNombre" class="text-slate-800"></strong> del directorio activo.
        </p>

        <form asp-controller="Proveedores" asp-action="Eliminar" method="post" class="flex gap-3">
            @Html.AntiForgeryToken()
            <input type="hidden" id="eliminarProveedorId" name="id" value="" />
            <button type="button" onclick="cerrarModalEliminarProveedor()" class="btn-brand-secondary flex-1">
                Cancelar
            </button>
            <button type="submit" class="btn-brand-primary !bg-red-600 hover:!bg-red-700 flex-1">
                Eliminar
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function filtrarProveedores() {
            const q = (document.getElementById('inputBuscarProveedor').value || '').trim().toLowerCase();
            const tarjetas = document.querySelectorAll('.tarjeta-proveedor');
            let visibles = 0;

            tarjetas.forEach(t => {
                const texto = t.getAttribute('data-busqueda') || '';
                if (q === '' || texto.includes(q)) {
                    t.classList.remove('hidden');
                    visibles++;
                } else {
                    t.classList.add('hidden');
                }
            });

            const msg = document.getElementById('sinProveedoresMsg');
            if (visibles === 0) {
                msg.classList.remove('hidden');
            } else {
                msg.classList.add('hidden');
            }
        }

        function validarRucEnVivo() {
            const input = document.getElementById('provRuc');
            const feedback = document.getElementById('feedbackRucAdapter');
            const v = input.value.trim();

            if (!v) {
                feedback.classList.add('hidden');
                return false;
            }

            feedback.classList.remove('hidden');

            if (!/^\d+$/.test(v)) {
                feedback.className = 'text-xs mt-1 text-red-600 font-medium';
                feedback.textContent = '⚠ Solo se permiten dígitos numéricos';
                return false;
            }

            if (v.length !== 11) {
                feedback.className = 'text-xs mt-1 text-amber-600 font-medium';
                feedback.textContent = `Faltan ${11 - v.length} dígito(s) para completar los 11 dígitos SUNAT`;
                return false;
            }

            const prefijo = v.substring(0, 2);
            if (prefijo === '20') {
                feedback.className = 'text-xs mt-1 text-emerald-700 font-semibold';
                feedback.textContent = '✓ RUC válido (Adapter: Persona Jurídica - RUC 20)';
                return true;
            } else if (prefijo === '10') {
                feedback.className = 'text-xs mt-1 text-emerald-700 font-semibold';
                feedback.textContent = '✓ RUC válido (Adapter: Persona Natural con Negocio - RUC 10)';
                return true;
            } else if (prefijo === '15' || prefijo === '17') {
                feedback.className = 'text-xs mt-1 text-emerald-700 font-semibold';
                feedback.textContent = '✓ RUC válido (Adapter: Régimen Especial SUNAT)';
                return true;
            } else {
                feedback.className = 'text-xs mt-1 text-red-600 font-medium';
                feedback.textContent = '⚠ El RUC debe iniciar con prefijo oficial SUNAT (10 o 20)';
                return false;
            }
        }

        function validarFormularioProveedor() {
            return validarRucEnVivo();
        }

        function abrirModalNuevoProveedor() {
            document.getElementById('modalProveedorTitulo').textContent = 'Nuevo proveedor';
            document.getElementById('btnGuardarProveedor').textContent = 'Registrar';
            document.getElementById('provId').value = '';
            document.getElementById('provRuc').value = '';
            document.getElementById('provRazonSocial').value = '';
            document.getElementById('provNombreComercial').value = '';
            document.getElementById('provContacto').value = '';
            document.getElementById('provTelefono').value = '';
            document.getElementById('provEmail').value = '';
            document.getElementById('provDireccion').value = '';
            document.getElementById('feedbackRucAdapter').classList.add('hidden');

            const modal = document.getElementById('modalProveedor');
            modal.classList.remove('hidden');
            modal.classList.add('grid');
            document.getElementById('provRuc').focus();
        }

        function abrirModalEditarProveedor(id, ruc, razonSocial, nombreComercial, contacto, telefono, email, direccion) {
            document.getElementById('modalProveedorTitulo').textContent = 'Editar proveedor';
            document.getElementById('btnGuardarProveedor').textContent = 'Guardar cambios';
            document.getElementById('provId').value = id;
            document.getElementById('provRuc').value = ruc;
            document.getElementById('provRazonSocial').value = razonSocial;
            document.getElementById('provNombreComercial').value = nombreComercial || '';
            document.getElementById('provContacto').value = contacto || '';
            document.getElementById('provTelefono').value = telefono || '';
            document.getElementById('provEmail').value = email || '';
            document.getElementById('provDireccion').value = direccion || '';

            validarRucEnVivo();

            const modal = document.getElementById('modalProveedor');
            modal.classList.remove('hidden');
            modal.classList.add('grid');
        }

        function cerrarModalProveedor() {
            const modal = document.getElementById('modalProveedor');
            modal.classList.add('hidden');
            modal.classList.remove('grid');
        }

        function abrirModalEliminarProveedor(id, nombre) {
            document.getElementById('eliminarProveedorId').value = id;
            document.getElementById('eliminarProveedorNombre').textContent = nombre;
            const modal = document.getElementById('modalEliminarProveedor');
            modal.classList.remove('hidden');
            modal.classList.add('grid');
        }

        function cerrarModalEliminarProveedor() {
            const modal = document.getElementById('modalEliminarProveedor');
            modal.classList.add('hidden');
            modal.classList.remove('grid');
        }

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                cerrarModalProveedor();
                cerrarModalEliminarProveedor();
            }
        });
    </script>
}
